# Feliactyl v2.2.0 — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# Generate secrets with: openssl rand -hex 32

# ============================================
# SECURITY - API Keys & Secrets
# ============================================

# Discord OAuth2 Credentials
DISCORD_OAUTH2_ID=your_oauth2_client_id
DISCORD_OAUTH2_SECRET=your_oauth2_client_secret

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_test_guild_id_for_development_hot_reloads

# AI Support Assistant (Gemini API Key - optional)
GEMINI_API_KEY=AIzaSy...

# Pterodactyl Panel API Key
PTERODACTYL_KEY=your_pterodactyl_api_key

# Feliactyl Internal API Key
FELIACTYL_API_CODE=your_secure_random_api_key_here

# Session Secret (generate strong random string)
SESSION_SECRET=your_very_secure_session_secret_min_32_chars

# ============================================
# Stripe Payments (if enabled)
# ============================================
STRIPE_KEY=your_stripe_secret_key

# ============================================
# Cloudflare Turnstile (CAPTCHA)
# ============================================
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ============================================
# Referral System
# ============================================
REFERRAL_REWARD_COINS=100
REFERRAL_MIN_PURCHASE=0

# ============================================
# Runtime
# ============================================
NODE_ENV=production
# PORT=8000   # Overrides website.port in settings.json if set

# Optional: Database (defaults to SQLite)
# Uncomment and set to use PostgreSQL or MySQL
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/feliactyl
# DATABASE_URL=mysql://user:password@localhost:3306/feliactyl

# ============================================
# SaaS / Multi-Tenant Configurations
# ============================================
# MONGODB_URI=mongodb://localhost:27017/feliactyl-bot
# ENCRYPTION_KEY=your_secure_32_char_encryption_key
