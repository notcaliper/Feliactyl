            <%= (userinfo && userinfo.username) ? userinfo.username.charAt(0).toUpperCase() : '?' %>
          </div>
          <%= (userinfo && userinfo.username) ? userinfo.username : 'Account' %>
        </a>
        <div class="dropdown-menu dropdown-menu-end">
          <div style="padding:8px 12px;border-bottom:1px solid rgba(255,255,255,0.07);margin-bottom:4px;">
