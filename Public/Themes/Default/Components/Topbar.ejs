<nav class="navbar navbar-expand navbar-light navbar-bg tb-nav">
  <div class="tb-left">
    <a class="sidebar-toggle js-sidebar-toggle tb-toggle">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </a>
    <div class="tb-breadcrumb" id="tb-breadcrumb"></div>
  </div>
  <div class="tb-right">
    <div class="tb-coin-chip">
      <svg width="13" height="13" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      <span id="topbar-coins" data-coins="<%= coins %>">0</span>
      <span style="color:#6b7280;font-size:11px;">coins</span>
    </div>
    <div class="tb-divider"></div>
    <div class="nav-item dropdown">
      <a class="tb-avatar-btn dropdown-toggle" href="#" data-bs-toggle="dropdown">
        <% const _tbAvatar = (userinfo && userinfo.id && userinfo.avatar) ? 'https://cdn.discordapp.com/avatars/' + userinfo.id + '/' + userinfo.avatar + '.png?size=64' : null; %>
        <% const _tbInitial = (userinfo && userinfo.username) ? (userinfo.username.replace(/^[^a-zA-Z0-9]+/,'').charAt(0)||userinfo.username.charAt(0)).toUpperCase() : '?'; %>
        <div class="tb-avatar" style="<%= _tbAvatar ? 'padding:0;overflow:hidden;background:none;' : '' %>">
          <% if (_tbAvatar) { %><img src="<%= _tbAvatar %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.style.display='none';this.parentNode.textContent='<%= _tbInitial %>';this.parentNode.style.background='linear-gradient(135deg,#7c3aed,#3b82f6)';"><% } else { %><%= _tbInitial %><% } %>
        </div>
        <div class="tb-user-meta">
          <span class="tb-user-name"><%= (userinfo && userinfo.username) ? userinfo.username : 'User' %></span>
          <% if (typeof packagename !== 'undefined') { %><span class="tb-user-plan"><%= packagename %></span><% } %>
        </div>
        <svg width="12" height="12" fill="none" stroke="#6b7280" stroke-width="2" viewBox="0 0 24 24" style="margin-left:4px;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
      <div class="dropdown-menu dropdown-menu-end tb-dropdown">
        <div class="tb-dd-header">
          <div class="tb-dd-avatar" style="<%= _tbAvatar ? 'padding:0;overflow:hidden;background:none;' : '' %>">
            <% if (_tbAvatar) { %><img src="<%= _tbAvatar %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.style.display='none';this.parentNode.textContent='<%= _tbInitial %>';this.parentNode.style.background='linear-gradient(135deg,#7c3aed,#3b82f6)';"><% } else { %><%= _tbInitial %><% } %>
          </div>
          <div>
            <div class="tb-dd-name"><%= (userinfo && userinfo.username) ? userinfo.username : '' %></div>
            <% if (typeof packagename !== 'undefined') { %><div class="tb-dd-plan"><%= packagename %></div><% } %>
          </div>
        </div>
        <div class="tb-dd-sep"></div>
        <a class="tb-dd-item" href="/settings">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Account Settings
        </a>
        <div class="tb-dd-sep"></div>
        <a class="tb-dd-item tb-dd-item--danger" href="/logout">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign out
        </a>
      </div>
    </div>
  </div>
</nav>
<script>
(function(){
  const tbc = document.getElementById('topbar-coins');
  if(tbc){ const v=parseFloat(tbc.dataset.coins)||0; tbc.textContent=Math.floor(v*100)/100; }
  const bc = document.getElementById('tb-breadcrumb');
  if(bc){
    const parts = location.pathname.split('/').filter(Boolean);
    if(!parts.length){ bc.innerHTML='<span class="tb-bc-item">Dashboard</span>'; }
    else {
      const labels = { admin:'Admin', users:'Users', plans:'Plans', settings:'Settings', logs:'Logs', dashboard:'Dashboard', store:'Store', earn:'AFK Earn', j4r:'Join for Rewards', gift:'Gift Coins', redeem:'Redeem', buy:'Buy Coins', servers:'Servers', 'new':'New Server' };
      bc.innerHTML = parts.map((p,i)=>`<span class="tb-bc-item${i===parts.length-1?' tb-bc-item--active':''}">${labels[p]||p.charAt(0).toUpperCase()+p.slice(1)}</span>`).join('<span class="tb-bc-sep">/</span>');
    }
  }
})();
</script>
