<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>
<%- include('../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../Components/Topbar.ejs') %>

      <main class="content">

        <div class="adm-page-header">
          <div>
            <div class="page-title">Plans</div>
            <div class="page-subtitle">Create and manage resource packages</div>
          </div>
          <div class="adm-tab-nav">
            <a href="/admin" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Overview
            </a>
            <a href="/admin/users" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Users
            </a>
            <a href="/admin/plans" class="adm-tab adm-tab--active">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              Plans
            </a>
            <a href="/admin/settings" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Settings
            </a>
            <a href="/admin/logs" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              Logs
            </a>
          </div>
        </div>

        <div id="plans-alert" class="plans-alert" style="display:none;"></div>

        <div class="row g-4">

          <!-- Existing plans -->
          <div class="col-lg-7">
            <div class="plans-card">
              <div class="plans-card-header">
                <div class="plans-icon plans-icon--purple">
                  <svg width="15" height="15" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                </div>
                <div style="flex:1;">
                  <div class="plans-card-title">Current Plans</div>
                  <div class="plans-card-desc">All configured resource packages</div>
                </div>
                <span class="plans-badge" id="plan-count">0</span>
              </div>
              <div class="plans-card-body">
                <div id="plans-list"></div>
              </div>
            </div>
          </div>

          <!-- Add new plan -->
          <div class="col-lg-5">
            <div class="plans-card plans-card--green">
              <div class="plans-card-header">
                <div class="plans-icon plans-icon--green">
                  <svg width="15" height="15" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div style="flex:1;">
                  <div class="plans-card-title">New Plan</div>
                  <div class="plans-card-desc">Define a new resource package</div>
                </div>
              </div>
              <div class="plans-card-body">
                <div class="plans-field mb-2">
                  <label>Plan Name</label>
                  <input type="text" id="new-name" class="form-control plans-input" placeholder="e.g. premium">
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <div class="plans-field">
                      <label>RAM (MB)</label>
                      <input type="number" id="new-ram" class="form-control plans-input" placeholder="1024" min="0">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="plans-field">
                      <label>Disk (MB)</label>
                      <input type="number" id="new-disk" class="form-control plans-input" placeholder="1024" min="0">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="plans-field">
                      <label>CPU (%)</label>
                      <input type="number" id="new-cpu" class="form-control plans-input" placeholder="100" min="0">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="plans-field">
                      <label>Servers</label>
                      <input type="number" id="new-servers" class="form-control plans-input" placeholder="1" min="0">
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="plans-field">
                      <label>Cost <small>(coins to purchase)</small></label>
                      <input type="number" id="new-cost" class="form-control plans-input" placeholder="0" min="0">
                    </div>
                  </div>
                </div>
                <button onclick="addPlan()" class="btn plans-btn plans-btn--green w-100">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Add Plan
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- Discounts section -->
        <div class="row g-4" style="margin-top:4px;">

          <!-- Active discounts list -->
          <div class="col-lg-7">
            <div class="plans-card plans-card--amber">
              <div class="plans-card-header">
                <div class="plans-icon plans-icon--amber">
                  <svg width="15" height="15" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                </div>
                <div style="flex:1;">
                  <div class="plans-card-title">Active Discounts</div>
                  <div class="plans-card-desc">Time-limited sale prices per plan</div>
                </div>
                <span class="plans-badge plans-badge--amber" id="discount-count">0</span>
              </div>
              <div class="plans-card-body">
                <div id="discounts-list"><div class="plans-empty">No discounts configured.</div></div>
              </div>
            </div>
          </div>

          <!-- Add discount -->
          <div class="col-lg-5">
            <div class="plans-card plans-card--amber">
              <div class="plans-card-header">
                <div class="plans-icon plans-icon--amber">
                  <svg width="15" height="15" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div style="flex:1;">
                  <div class="plans-card-title">New Discount</div>
                  <div class="plans-card-desc">Add a timed sale to a plan</div>
                </div>
              </div>
              <div class="plans-card-body">
                <div class="plans-field mb-2">
                  <label>Plan</label>
                  <select id="disc-plan" class="form-select plans-input">
                    <option value="">— select plan —</option>
                  </select>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <div class="plans-field">
                      <label>Discount %</label>
                      <input type="number" id="disc-pct" class="form-control plans-input" placeholder="20" min="1" max="100">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="plans-field">
                      <label>Expires (hrs) <small>0 = never</small></label>
                      <input type="number" id="disc-hrs" class="form-control plans-input" placeholder="0" min="0">
                    </div>
                  </div>
                </div>
                <button onclick="addDiscount()" class="btn plans-btn plans-btn--amber w-100">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Add Discount
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- Sticky save bar -->
        <div class="plans-save-bar" id="save-bar">
          <div style="display:flex;align-items:center;gap:10px;">
            <div class="plans-save-dot"></div>
            <span style="font-size:13px;color:#c4b5fd;font-weight:600;">Unsaved changes</span>
          </div>
          <button onclick="savePlans()" class="btn plans-btn plans-btn--purple" id="save-btn">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Changes
          </button>
        </div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">&copy; <%= settings.name %> &middot; <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> &middot; <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../Components/LoadingBar.ejs') %>

  <style>
    .plans-card {
      background: var(--surface);
      border: 1px solid rgba(139,92,246,0.14);
      border-radius: 16px;
      overflow: hidden;
      position: relative;
    }
    .plans-card::before {
      content:''; position:absolute; inset:0 0 auto 0; height:3px; border-radius:16px 16px 0 0;
      background: linear-gradient(90deg,#7c3aed,#a78bfa);
    }
    .plans-card--green::before { background: linear-gradient(90deg,#059669,#6ee7b7); }
    .plans-card-header {
      display:flex; align-items:center; gap:12px;
      padding:16px 20px 14px;
      border-bottom:1px solid rgba(139,92,246,0.08);
    }
    .plans-card-title { font-size:14px; font-weight:700; color:#e2e8f0; }
    .plans-card-desc  { font-size:12px; color:#6b7280; margin-top:2px; }
    .plans-icon {
      width:32px; height:32px; border-radius:8px; flex-shrink:0;
      display:flex; align-items:center; justify-content:center;
    }
    .plans-icon--purple { background:rgba(124,58,237,0.15); border:1px solid rgba(124,58,237,0.22); }
    .plans-icon--green  { background:rgba(16,185,129,0.15);  border:1px solid rgba(16,185,129,0.22); }
    .plans-badge {
      background: rgba(124,58,237,0.2); color:#c4b5fd;
      font-size:11px; font-weight:700; padding:2px 8px; border-radius:20px;
    }
    .plans-card-body { padding:16px 18px 18px; }

    .plans-field { display:flex; flex-direction:column; gap:5px; }
    .plans-field label { font-size:11px; font-weight:700; color:#7c6faa; text-transform:uppercase; letter-spacing:0.7px; }
    .plans-field label small { font-size:10px; color:#4b4669; text-transform:none; font-weight:400; margin-left:4px; }
    .plans-input {
      background: var(--surface2) !important;
      border: 1px solid rgba(139,92,246,0.18) !important;
      border-radius: 8px !important;
      color: #e2e8f0 !important;
      font-size:13px !important;
      padding: 8px 11px !important;
    }
    .plans-input:focus { border-color:#7c3aed!important; box-shadow:0 0 0 3px rgba(124,58,237,0.15)!important; outline:none!important; }
    .plans-input::placeholder { color:#4b4669!important; }

    .plans-btn {
      font-size:13px!important; font-weight:600!important; padding:9px 16px!important;
      border:none!important; border-radius:9px!important;
      display:inline-flex; align-items:center; justify-content:center;
      transition:all 0.15s!important;
    }
    .plans-btn:hover { transform:translateY(-1px)!important; filter:brightness(1.1)!important; }
    .plans-btn--purple { background:linear-gradient(135deg,#7c3aed,#a78bfa)!important; color:white!important; box-shadow:0 2px 10px rgba(124,58,237,0.3)!important; }
    .plans-btn--green  { background:linear-gradient(135deg,#059669,#34d399)!important; color:white!important; box-shadow:0 2px 10px rgba(16,185,129,0.3)!important; }
    .plans-btn--red    { background:rgba(220,38,38,0.12)!important; color:#fca5a5!important; border:1px solid rgba(220,38,38,0.2)!important; padding:5px 10px!important; font-size:12px!important; }
    .plans-btn--red:hover { background:rgba(220,38,38,0.22)!important; }

    .adm-page-header { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px; }
    .adm-tab-nav { display:flex;gap:4px;background:rgba(255,255,255,.03);border:1px solid rgba(139,92,246,.14);border-radius:12px;padding:4px; }
    .adm-tab { display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:9px;font-size:12px;font-weight:600;color:#6b7280;text-decoration:none;transition:all .15s; }
    .adm-tab:hover { color:#c4b5fd;background:rgba(124,58,237,.08);text-decoration:none; }
    .adm-tab--active { background:rgba(124,58,237,.18);color:#c4b5fd;border:1px solid rgba(124,58,237,.25); }

    /* plan row */
    .plan-row {
      display:flex; align-items:center; gap:10px;
      padding:12px 14px;
      border-radius:10px;
      background: rgba(139,92,246,0.04);
      border: 1px solid rgba(139,92,246,0.1);
      margin-bottom:8px;
      transition: border-color 0.15s;
    }
    .plan-row:hover { border-color: rgba(124,58,237,0.25); }
    .plan-row:last-child { margin-bottom:0; }
    .plan-name {
      font-size:13px; font-weight:700; color:#c4b5fd; min-width:90px;
      display:flex; align-items:center; gap:6px;
    }
    .plan-default-badge {
      font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;
      background:rgba(124,58,237,0.25); color:#a78bfa; padding:2px 6px; border-radius:4px;
    }
    .plan-stats {
      display:flex; flex-wrap:wrap; gap:6px; flex:1;
    }
    .plan-stat {
      font-size:11px; color:#6b7280;
      background:rgba(0,0,0,0.2); border-radius:5px; padding:2px 7px;
    }
    .plan-stat span { color:#9d8ec7; font-weight:600; }

    /* save bar */
    .plans-save-bar {
      position:fixed; bottom:0; left:0; right:0; z-index:800;
      background:rgba(13,10,20,.95); backdrop-filter:blur(12px);
      border-top:1px solid rgba(124,58,237,.25);
      padding:14px 32px;
      display:flex; align-items:center; justify-content:space-between;
      transform:translateY(100%); transition:transform .25s cubic-bezier(.4,0,.2,1);
    }
    .plans-save-bar.visible { transform:translateY(0); }
    .plans-save-dot { width:8px;height:8px;border-radius:50%;background:#a78bfa;box-shadow:0 0 8px #a78bfa;animation:pulse-dot 1.4s ease-in-out infinite; }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }

    /* alert */
    .plans-alert { padding:12px 16px; border-radius:10px; font-size:13px; margin-bottom:16px; display:flex; align-items:center; gap:8px; }
    .plans-alert.success { background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); color:#6ee7b7; }
    .plans-alert.error   { background:rgba(220,38,38,0.1);  border:1px solid rgba(220,38,38,0.25);  color:#fca5a5; }

    .plans-empty { text-align:center; padding:32px 0; color:#4b4669; font-size:13px; }
    .plans-card--amber::before { background: linear-gradient(90deg,#d97706,#fcd34d); }
    .plans-icon--amber { background:rgba(217,119,6,0.15); border:1px solid rgba(217,119,6,0.25); }
    .plans-badge--amber { background:rgba(217,119,6,0.2); color:#fcd34d; }
    .plans-btn--amber { background:linear-gradient(135deg,#d97706,#fcd34d)!important; color:#1a1000!important; box-shadow:0 2px 10px rgba(217,119,6,0.3)!important; }
    .disc-row {
      display:flex; align-items:center; gap:10px;
      padding:11px 14px; border-radius:10px;
      background:rgba(217,119,6,0.05); border:1px solid rgba(217,119,6,0.15);
      margin-bottom:8px;
    }
    .disc-row:last-child { margin-bottom:0; }
    .disc-plan-name { font-size:13px; font-weight:700; color:#fcd34d; min-width:90px; }
    .disc-pct { font-size:20px; font-weight:900; color:#f59e0b; min-width:52px; }
    .disc-meta { flex:1; font-size:11px; color:#6b7280; }
  </style>

  <script>
    const initialPlans = <%- JSON.stringify(settings.api.client.packages.list) %>;
    const defaultPlan  = <%- JSON.stringify(settings.api.client.packages.default) %>;
    let plans = JSON.parse(JSON.stringify(initialPlans));
    let dirty = false;

    function renderPlans() {
      const list = document.getElementById('plans-list');
      const keys = Object.keys(plans);
      document.getElementById('plan-count').textContent = keys.length;

      if (keys.length === 0) {
        list.innerHTML = '<div class="plans-empty">No plans configured.</div>';
        return;
      }

      list.innerHTML = keys.map(name => {
        const p = plans[name];
        const isDefault = name === defaultPlan;
        return `
          <div class="plan-row" id="row-${name}">
            <div class="plan-name">
              ${name}
              ${isDefault ? '<span class="plan-default-badge">default</span>' : ''}
            </div>
            <div class="plan-stats">
              <div class="plan-stat"><span>${p.ram}</span> MB RAM</div>
              <div class="plan-stat"><span>${p.disk}</span> MB Disk</div>
              <div class="plan-stat"><span>${p.cpu}</span>% CPU</div>
              <div class="plan-stat"><span>${p.servers}</span> servers</div>
              <div class="plan-stat" style="color:#fbbf24;">🪙 <span style="color:#fcd34d;">${p.cost ?? 0}</span> coins</div>
            </div>
            ${!isDefault ? `<button class="btn plans-btn plans-btn--red" onclick="deletePlan('${name}')">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            </button>` : ''}
          </div>`;
      }).join('');
    }

    function addPlan() {
      const name    = document.getElementById('new-name').value.trim().replace(/\s+/g, '_');
      const ram     = parseInt(document.getElementById('new-ram').value);
      const disk    = parseInt(document.getElementById('new-disk').value);
      const cpu     = parseInt(document.getElementById('new-cpu').value);
      const servers = parseInt(document.getElementById('new-servers').value);
      const cost    = parseInt(document.getElementById('new-cost').value) || 0;

      if (!name) return showAlert('error', 'Plan name is required.');
      if (plans[name]) return showAlert('error', `Plan "${name}" already exists.`);
      if (isNaN(ram) || isNaN(disk) || isNaN(cpu) || isNaN(servers)) return showAlert('error', 'All resource fields are required.');

      plans[name] = { ram, disk, cpu, servers, cost };
      dirty = true;
      renderPlans();
      document.getElementById('save-bar').classList.add('visible');

      document.getElementById('new-name').value   = '';
      document.getElementById('new-ram').value    = '';
      document.getElementById('new-disk').value   = '';
      document.getElementById('new-cpu').value    = '';
      document.getElementById('new-servers').value = '';
      document.getElementById('new-cost').value    = '';
    }

    function deletePlan(name) {
      if (!confirm(`Delete plan "${name}"? Users on this plan will be reset to default.`)) return;
      delete plans[name];
      dirty = true;
      renderPlans();
      document.getElementById('save-bar').classList.add('visible');
    }

    function showAlert(type, msg) {
      const box = document.getElementById('plans-alert');
      const icon = type === 'success'
        ? `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`
        : `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;
      box.className = 'plans-alert ' + type;
      box.innerHTML = icon + msg;
      box.style.display = 'flex';
      setTimeout(() => box.style.display = 'none', 5000);
    }

    window.addEventListener('beforeunload', e => { if (dirty) e.returnValue = ''; });
    renderPlans();

    // ── Discounts ──
    // discounts stored as: settings.api.client.packages.discounts = { planName: { pct, expiresAt } }
    let discounts = JSON.parse(JSON.stringify(<%- JSON.stringify(settings.api.client.packages.discounts || {}) %>));

    function populatePlanSelect() {
      const sel = document.getElementById('disc-plan');
      sel.innerHTML = '<option value="">— select plan —</option>';
      Object.keys(plans).forEach(n => {
        const o = document.createElement('option'); o.value = n; o.textContent = n;
        sel.appendChild(o);
      });
    }

    function renderDiscounts() {
      const list = document.getElementById('discounts-list');
      const now  = Date.now();
      // prune expired
      Object.keys(discounts).forEach(k => { if (discounts[k].expiresAt && discounts[k].expiresAt < now) delete discounts[k]; });
      const keys = Object.keys(discounts);
      document.getElementById('discount-count').textContent = keys.length;
      if (!keys.length) { list.innerHTML = '<div class="plans-empty">No discounts configured.</div>'; return; }
      list.innerHTML = keys.map(plan => {
        const d = discounts[plan];
        const base = plans[plan] ? (plans[plan].cost || 0) : '?';
        const sale = typeof base === 'number' ? Math.round(base * (1 - d.pct / 100)) : '?';
        const expStr = d.expiresAt ? `Expires ${new Date(d.expiresAt).toLocaleString()}` : 'Never expires';
        return `<div class="disc-row">
          <div class="disc-pct">${d.pct}%</div>
          <div>
            <div class="disc-plan-name">${plan}</div>
            <div class="disc-meta">${expStr} &nbsp;·&nbsp; 🪙 <s style="color:#6b7280;">${base}</s> → <strong style="color:#fcd34d;">${sale}</strong> coins</div>
          </div>
          <div style="flex:1;"></div>
          <button class="btn plans-btn plans-btn--red" onclick="removeDiscount('${plan}')">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
          </button>
        </div>`;
      }).join('');
    }

    function addDiscount() {
      const plan = document.getElementById('disc-plan').value;
      const pct  = parseInt(document.getElementById('disc-pct').value);
      const hrs  = parseInt(document.getElementById('disc-hrs').value) || 0;
      if (!plan) return showAlert('error', 'Select a plan.');
      if (isNaN(pct) || pct < 1 || pct > 100) return showAlert('error', 'Discount % must be 1–100.');
      const expiresAt = hrs > 0 ? Date.now() + hrs * 3600000 : null;
      discounts[plan] = { pct, expiresAt };
      dirty = true;
      renderDiscounts();
      document.getElementById('save-bar').classList.add('visible');
      document.getElementById('disc-plan').value = '';
      document.getElementById('disc-pct').value  = '';
      document.getElementById('disc-hrs').value  = '';
    }

    function removeDiscount(plan) {
      delete discounts[plan];
      dirty = true;
      renderDiscounts();
      document.getElementById('save-bar').classList.add('visible');
    }

    async function savePlans() {
      const btn = document.getElementById('save-btn');
      btn.disabled = true;
      btn.innerHTML = `Saving...`;
      try {
        const res  = await fetch('/admin/settings/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ api: { client: { packages: { list: plans, discounts } } } })
        });
        const data = await res.json();
        if (data.success) {
          showAlert('success', 'Saved! Restart for full effect.');
          dirty = false;
          document.getElementById('save-bar').classList.remove('visible');
        } else {
          showAlert('error', 'Error: ' + (data.error || 'Unknown.'));
        }
      } catch(e) { showAlert('error', 'Request failed.'); }
      btn.disabled = false;
      btn.innerHTML = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>Save Changes`;
    }

    populatePlanSelect();
    renderDiscounts();
  </script>

</body>
</html>
