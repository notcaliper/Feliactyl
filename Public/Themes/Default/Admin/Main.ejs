<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>
<%- include('../Components/Styles.ejs') %>
<body>
  <div class="wrapper">
    <%- include('../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../Components/Topbar.ejs') %>

      <main class="content">

        <div class="adm-page-header">
          <div>
            <div class="page-title">Admin Panel</div>
            <div class="page-subtitle">Manage users, coins, resources and coupons</div>
          </div>
          <div class="adm-tab-nav">
            <a href="/admin" class="adm-tab adm-tab--active">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Overview
            </a>
            <a href="/admin/users" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Users
            </a>
            <a href="/admin/plans" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              Plans
            </a>
            <a href="/admin/settings" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Settings
            </a>
            <a href="/admin/logs" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              Logs
            </a>
          </div>
        </div>

        <% if (req.query.err === 'none') { %>
        <div class="adm-alert adm-alert--green mb-4">
          <svg width="14" height="14" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          Action completed successfully.
        </div>
        <% } else if (req.query.err && req.query.err !== 'none') { %>
        <div class="adm-alert adm-alert--red mb-4">
          <svg width="14" height="14" fill="none" stroke="#fca5a5" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Error: <strong><%= req.query.err %></strong>
        </div>
        <% } %>
        <% if (req.query.code) { %>
        <div class="adm-alert adm-alert--green mb-4">
          <svg width="14" height="14" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          Coupon created: <strong><%= req.query.code %></strong>
        </div>
        <% } %>

        <!-- Version / status bar -->
        <% const _cur = settings.version; const _latest = latestVersion; const _upToDate = _latest && _latest === _cur; const _updateAvail = _latest && _latest !== _cur; %>
        <div class="adm-status-bar mb-4">
          <div class="adm-status-left">
            <div class="adm-status-dot <%= !_latest ? 'adm-status-dot--gray' : (_upToDate ? 'adm-status-dot--green' : 'adm-status-dot--amber') %>"></div>
            <span class="adm-status-text">
              <% if (!_latest) { %>
                Running <code>v<%= _cur %></code>
              <% } else if (_upToDate) { %>
                Up to date &mdash; <code>v<%= _cur %></code>
              <% } else { %>
                Update available: <code>v<%= _cur %></code> &rarr; <code>v<%= _latest %></code> &nbsp;<a href="https://github.com/notcaliper/feliactyl" target="_blank" style="color:#a78bfa;font-weight:600;">Update &rarr;</a>
              <% } %>
            </span>
          </div>
          <div class="adm-status-meta">
            <span class="adm-status-chip">
              <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              <%= settings.api.client.packages ? Object.keys(settings.api.client.packages.list).length : 0 %> plans
            </span>
            <span class="adm-status-chip">
              <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              <%= settings.api.client.j4r && settings.api.client.j4r.ads ? settings.api.client.j4r.ads.length : 0 %> J4R servers
            </span>
          </div>
        </div>

        <!-- Section label -->
        <div class="adm-section-group-label">
          <svg width="13" height="13" fill="none" stroke="#4b5563" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          User Management
        </div>

        <!-- Admin action grid -->
        <div class="row g-4">

          <!-- Coins -->
          <div class="col-md-6">
            <div class="adm-card adm-card--purple">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--purple">
                  <svg width="16" height="16" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <span class="adm-card-title">Coins</span>
              </div>
              <div class="adm-card-body">
                <form action="/addcoins" method="GET">
                  <div class="adm-section-label adm-section-label--purple">Add Coins</div>
                  <div class="row g-2 mb-1">
                    <div class="col-7"><input class="form-control adm-input" name="id" placeholder="Discord ID"></div>
                    <div class="col-3"><input class="form-control adm-input" name="coins" placeholder="100" type="number" min="0"></div>
                    <div class="col-2"><button class="btn adm-btn adm-btn--purple w-100" type="submit" title="Add">
                      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button></div>
                  </div>
                </form>
                <div class="adm-divider"></div>
                <form action="/setcoins" method="GET">
                  <div class="adm-section-label" style="color:#6b7280;">Set Coins</div>
                  <div class="row g-2">
                    <div class="col-7"><input class="form-control adm-input" name="id" placeholder="Discord ID"></div>
                    <div class="col-3"><input class="form-control adm-input" name="coins" placeholder="100" type="number" min="0"></div>
                    <div class="col-2"><button class="btn adm-btn adm-btn--muted w-100" type="submit" title="Set">
                      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    </button></div>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Plan -->
          <div class="col-md-6">
            <div class="adm-card adm-card--blue">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--blue">
                  <svg width="16" height="16" fill="none" stroke="#93c5fd" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                </div>
                <span class="adm-card-title">Set Plan</span>
              </div>
              <div class="adm-card-body">
                <form action="/setplan" method="POST">
                  <div class="mb-2">
                    <div class="adm-section-label adm-section-label--blue">Discord ID</div>
                    <input class="form-control adm-input" name="id" placeholder="0000000000000000">
                  </div>
                  <div class="mb-3">
                    <div class="adm-section-label adm-section-label--blue">Plan</div>
                    <select class="form-control adm-input adm-select" name="package">
                      <% for (let [name, value] of Object.entries(settings.api.client.packages.list)) { %>
                        <option value="<%= name %>"><%= name %> &mdash; <%= value.ram %>MB RAM, <%= value.disk %>MB Disk, <%= value.cpu %>% CPU, <%= value.servers %> servers</option>
                      <% } %>
                    </select>
                  </div>
                  <button class="btn adm-btn adm-btn--blue" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    Apply Plan
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Add Resources -->
          <div class="col-md-6">
            <div class="adm-card adm-card--green">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--green">
                  <svg width="16" height="16" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <span class="adm-card-title">Add Resources</span>
              </div>
              <div class="adm-card-body">
                <form action="/addresources" method="POST">
                  <div class="mb-2"><input class="form-control adm-input" name="id" placeholder="Discord ID"></div>
                  <div class="row g-2 mb-3">
                    <div class="col-6"><input class="form-control adm-input" name="ram" placeholder="RAM (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="disk" placeholder="Disk (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="cpu" placeholder="CPU (%)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="servers" placeholder="Servers" type="number" min="0"></div>
                  </div>
                  <button class="btn adm-btn adm-btn--green" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Resources
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Set Resources -->
          <div class="col-md-6">
            <div class="adm-card adm-card--amber">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--amber">
                  <svg width="16" height="16" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </div>
                <span class="adm-card-title">Set Resources</span>
              </div>
              <div class="adm-card-body">
                <form action="/setresources" method="POST">
                  <div class="mb-2"><input class="form-control adm-input" name="id" placeholder="Discord ID"></div>
                  <div class="row g-2 mb-3">
                    <div class="col-6"><input class="form-control adm-input" name="ram" placeholder="RAM (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="disk" placeholder="Disk (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="cpu" placeholder="CPU (%)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="servers" placeholder="Servers" type="number" min="0"></div>
                  </div>
                  <button class="btn adm-btn adm-btn--amber" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    Set Resources
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- section label -->
          <div class="col-12" style="padding-bottom:0;margin-bottom:-8px;">
            <div class="adm-section-group-label">
              <svg width="13" height="13" fill="none" stroke="#4b5563" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              Coupons
            </div>
          </div>

          <!-- Coupons -->
          <div class="col-md-6">
            <div class="adm-card adm-card--teal">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--teal">
                  <svg width="16" height="16" fill="none" stroke="#5eead4" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                </div>
                <span class="adm-card-title">Create Coupon</span>
              </div>
              <div class="adm-card-body">
                <form action="/create_coupon" method="POST">
                  <div class="mb-2"><input class="form-control adm-input" name="code" placeholder="Code (blank = auto-generate)"></div>
                  <div class="row g-2 mb-3">
                    <div class="col-6"><input class="form-control adm-input" name="coins" placeholder="Coins" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="ram" placeholder="RAM (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="disk" placeholder="Disk (MB)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="cpu" placeholder="CPU (%)" type="number" min="0"></div>
                    <div class="col-6"><input class="form-control adm-input" name="servers" placeholder="Servers" type="number" min="0"></div>
                  </div>
                  <button class="btn adm-btn adm-btn--teal" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Create Coupon
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Revoke Coupon -->
          <div class="col-md-6">
            <div class="adm-card adm-card--red">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--red">
                  <svg width="16" height="16" fill="none" stroke="#fca5a5" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </div>
                <span class="adm-card-title">Revoke Coupon</span>
              </div>
              <div class="adm-card-body">
                <form action="/revoke_coupon" method="POST">
                  <div class="mb-3">
                    <div class="adm-section-label" style="color:#f87171;">Coupon Code</div>
                    <input class="form-control adm-input adm-input--red" name="code" placeholder="EXAMPLE100">
                  </div>
                  <button class="btn adm-btn adm-btn--red" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    Revoke Coupon
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- section label -->
          <div class="col-12" style="padding-bottom:0;margin-bottom:-8px;">
            <div class="adm-section-group-label">
              <svg width="13" height="13" fill="none" stroke="#4b5563" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Join for Rewards
            </div>
          </div>

          <!-- J4R Management -->
          <div class="col-12">
            <div class="adm-card adm-card--purple">
              <div class="adm-card-header">
                <div class="adm-card-icon adm-card-icon--purple">
                  <svg width="16" height="16" fill="none" stroke="#a78bfa" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <span class="adm-card-title">Join for Rewards — Servers</span>
              </div>
              <div class="adm-card-body">

                <!-- Existing servers -->
                <% if (settings.api.client.j4r.ads && settings.api.client.j4r.ads.length > 0) { %>
                <div class="adm-section-label adm-section-label--purple mb-2">Current Servers</div>
                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:18px;">
                  <% for (let i = 0; i < settings.api.client.j4r.ads.length; i++) { %>
                  <div style="display:flex;align-items:center;gap:12px;background:rgba(124,58,237,0.07);border:1px solid rgba(124,58,237,0.16);border-radius:10px;padding:10px 14px;">
                    <div style="flex:1;min-width:0;">
                      <div style="font-size:13px;font-weight:600;color:#e2e8f0;"><%= settings.api.client.j4r.ads[i].name %></div>
                      <div style="font-size:11px;color:#6b7280;margin-top:2px;">ID: <%= settings.api.client.j4r.ads[i].id %> &middot; 🪙 <%= settings.api.client.j4r.ads[i].coins %> coins</div>
                    </div>
                    <form action="/admin/j4r/remove" method="POST" style="margin:0;">
                      <input type="hidden" name="id" value="<%= settings.api.client.j4r.ads[i].id %>">
                      <button class="btn adm-btn adm-btn--red" type="submit" style="padding:6px 12px!important;font-size:11px!important;">
                        <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:4px;vertical-align:-1px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                        Remove
                      </button>
                    </form>
                  </div>
                  <% } %>
                </div>
                <% } else { %>
                <div style="font-size:13px;color:#6b7280;margin-bottom:18px;">No J4R servers configured yet.</div>
                <% } %>

                <!-- Add new server -->
                <div class="adm-section-label adm-section-label--purple mb-2">Add Server</div>
                <form action="/admin/j4r/add" method="POST">
                  <div class="row g-2 mb-3">
                    <div class="col-md-4"><input class="form-control adm-input" name="name" placeholder="Server Name" required></div>
                    <div class="col-md-4"><input class="form-control adm-input" name="invite" placeholder="Invite URL (https://discord.gg/...)" required></div>
                    <div class="col-md-2"><input class="form-control adm-input" name="id" placeholder="Server ID" required></div>
                    <div class="col-md-2"><input class="form-control adm-input" name="coins" placeholder="Coins" type="number" min="1" required></div>
                  </div>
                  <button class="btn adm-btn adm-btn--purple" type="submit">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Server
                  </button>
                </form>

              </div>
            </div>
          </div>

        </div>
      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">&copy; <%= settings.name %> &middot; <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> &middot; <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>

  <style>
    /* ── Page header & tabs ── */
    .adm-page-header { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px; }
    .adm-tab-nav { display:flex;gap:4px;background:rgba(255,255,255,.03);border:1px solid rgba(139,92,246,.14);border-radius:12px;padding:4px; }
    .adm-tab {
      display:inline-flex;align-items:center;gap:6px;
      padding:7px 14px;border-radius:9px;font-size:12px;font-weight:600;
      color:#6b7280;text-decoration:none;transition:all .15s;
    }
    .adm-tab:hover { color:#c4b5fd;background:rgba(124,58,237,.08);text-decoration:none; }
    .adm-tab--active { background:rgba(124,58,237,.18);color:#c4b5fd;border:1px solid rgba(124,58,237,.25); }

    /* ── Status bar ── */
    .adm-status-bar { display:flex;align-items:center;gap:12px;background:rgba(124,58,237,.05);border:1px solid rgba(124,58,237,.14);border-radius:12px;padding:11px 16px;flex-wrap:wrap; }
    .adm-status-left { display:flex;align-items:center;gap:10px;flex:1;min-width:0; }
    .adm-status-dot { width:9px;height:9px;border-radius:50%;flex-shrink:0;background:#4b5563;animation:pulse 2s infinite; }
    .adm-status-dot--green { background:#10b981;box-shadow:0 0 6px rgba(16,185,129,.5); }
    .adm-status-dot--amber { background:#f59e0b;box-shadow:0 0 6px rgba(245,158,11,.5); }
    .adm-status-dot--gray  { background:#4b5563; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.6} }
    .adm-status-text { font-size:13px;color:#9ca3af; }
    .adm-status-text code { background:rgba(139,92,246,.15);padding:1px 5px;border-radius:4px;font-size:12px;color:#c4b5fd; }
    .adm-status-meta { display:flex;gap:8px;flex-shrink:0; }
    .adm-status-chip { display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:4px 10px;border-radius:20px;background:rgba(139,92,246,.08);color:#7c6faa;border:1px solid rgba(139,92,246,.14); }

    /* ── Section group label ── */
    .adm-section-group-label { display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#374151;margin-bottom:12px; }

    .adm-alert { display:flex;align-items:center;gap:8px;padding:12px 16px;border-radius:10px;font-size:13px; }
    .adm-alert--green { background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);color:#6ee7b7; }
    .adm-alert--green strong { color:#a7f3d0; }
    .adm-alert--red { background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);color:#fca5a5; }
    .adm-alert--red strong { color:#fecaca; }
    .adm-card { background:var(--surface);border-radius:16px;overflow:hidden;position:relative;border:1px solid rgba(139,92,246,0.14);height:100%;display:flex;flex-direction:column; }
    .adm-card::before { content:'';position:absolute;inset:0 0 auto 0;height:3px;border-radius:16px 16px 0 0; }
    .adm-card--purple::before { background:linear-gradient(90deg,#7c3aed,#a78bfa); }
    .adm-card--blue::before   { background:linear-gradient(90deg,#2563eb,#60a5fa); }
    .adm-card--green::before  { background:linear-gradient(90deg,#059669,#6ee7b7); }
    .adm-card--amber::before  { background:linear-gradient(90deg,#d97706,#fcd34d); }
    .adm-card--teal::before   { background:linear-gradient(90deg,#0d9488,#5eead4); }
    .adm-card--red::before    { background:linear-gradient(90deg,#dc2626,#fca5a5); }
    .adm-card-header { display:flex;align-items:center;gap:12px;padding:16px 20px 14px;border-bottom:1px solid rgba(139,92,246,0.08); }
    .adm-card-icon { width:36px;height:36px;flex-shrink:0;border-radius:9px;display:flex;align-items:center;justify-content:center; }
    .adm-card-icon--purple { background:rgba(124,58,237,0.15);border:1px solid rgba(124,58,237,0.22); }
    .adm-card-icon--blue   { background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.22); }
    .adm-card-icon--green  { background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.22); }
    .adm-card-icon--amber  { background:rgba(217,119,6,0.15);border:1px solid rgba(217,119,6,0.22); }
    .adm-card-icon--teal   { background:rgba(13,148,136,0.15);border:1px solid rgba(13,148,136,0.22); }
    .adm-card-icon--red    { background:rgba(220,38,38,0.15);border:1px solid rgba(220,38,38,0.22); }
    .adm-card-title { font-size:14px;font-weight:700;color:#e2e8f0; }
    .adm-card-body { padding:16px 20px 20px;flex:1; }
    .adm-section-label { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:8px; }
    .adm-section-label--purple { color:#a78bfa; }
    .adm-section-label--blue   { color:#93c5fd; }
    .adm-section-label--green  { color:#6ee7b7; }
    .adm-section-label--teal   { color:#5eead4; }
    .adm-divider { border-top:1px solid rgba(139,92,246,0.1);margin:14px 0; }
    .adm-input { background:var(--surface2)!important;border:1px solid rgba(139,92,246,0.18)!important;border-radius:9px!important;color:#e2e8f0!important;font-size:13px!important;padding:9px 12px!important; }
    .adm-input:focus { border-color:#7c3aed!important;box-shadow:0 0 0 3px rgba(124,58,237,0.15)!important;outline:none!important; }
    .adm-input::placeholder { color:#4b4669!important; }
    .adm-input--red { border-color:rgba(220,38,38,0.25)!important; }
    .adm-input--red:focus { border-color:#ef4444!important;box-shadow:0 0 0 3px rgba(220,38,38,0.15)!important; }
    .adm-select { appearance:auto!important;cursor:pointer; }
    .adm-btn { font-size:13px!important;font-weight:600!important;padding:9px 18px!important;border:none!important;border-radius:9px!important;display:inline-flex;align-items:center;justify-content:center;transition:all 0.15s!important; }
    .adm-btn:hover { transform:translateY(-1px)!important;filter:brightness(1.1)!important; }
    .adm-btn--purple { background:linear-gradient(135deg,#7c3aed,#a78bfa)!important;color:white!important;box-shadow:0 2px 10px rgba(124,58,237,0.3)!important; }
    .adm-btn--muted  { background:rgba(139,92,246,0.12)!important;color:#a78bfa!important;border:1px solid rgba(139,92,246,0.22)!important; }
    .adm-btn--blue   { background:linear-gradient(135deg,#2563eb,#60a5fa)!important;color:white!important;box-shadow:0 2px 10px rgba(37,99,235,0.3)!important; }
    .adm-btn--green  { background:linear-gradient(135deg,#059669,#34d399)!important;color:white!important;box-shadow:0 2px 10px rgba(16,185,129,0.3)!important; }
    .adm-btn--amber  { background:linear-gradient(135deg,#d97706,#fcd34d)!important;color:#1a1000!important;box-shadow:0 2px 10px rgba(217,119,6,0.3)!important; }
    .adm-btn--teal   { background:linear-gradient(135deg,#0d9488,#5eead4)!important;color:#001a18!important;box-shadow:0 2px 10px rgba(13,148,136,0.3)!important; }
    .adm-btn--red    { background:linear-gradient(135deg,#dc2626,#f87171)!important;color:white!important;box-shadow:0 2px 10px rgba(220,38,38,0.3)!important; }
  </style>
    </div>
  </div>

