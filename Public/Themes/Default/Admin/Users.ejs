<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>
<%- include('../Components/Styles.ejs') %>
<body>
  <div class="wrapper">
    <%- include('../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../Components/Topbar.ejs') %>

      <main class="content">

        <div class="adm-page-header">
          <div>
            <div class="page-title">All Users</div>
            <div class="page-subtitle">View all registered users, their coins, plans and resources</div>
          </div>
          <div class="adm-tab-nav">
            <a href="/admin" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Overview
            </a>
            <a href="/admin/users" class="adm-tab adm-tab--active">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Users
            </a>
            <a href="/admin/plans" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              Plans
            </a>
            <a href="/admin/settings" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
              Settings
            </a>
            <a href="/admin/logs" class="adm-tab">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              Logs
            </a>
          </div>
        </div>

        <!-- Stat strip -->
        <div class="users-stat-strip mb-4" id="statStrip" style="display:none;">
          <div class="users-stat">
            <div class="users-stat-icon users-stat-icon--purple">
              <svg width="14" height="14" fill="none" stroke="#a78bfa" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <div class="users-stat-label">Total Users</div>
              <div class="users-stat-val" id="statTotal">—</div>
            </div>
          </div>
          <div class="users-stat">
            <div class="users-stat-icon users-stat-icon--amber">
              <svg width="14" height="14" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <div class="users-stat-label">Total Coins</div>
              <div class="users-stat-val" id="statCoins">—</div>
            </div>
          </div>
          <div class="users-stat">
            <div class="users-stat-icon users-stat-icon--red">
              <svg width="14" height="14" fill="none" stroke="#fca5a5" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="users-stat-label">Admins</div>
              <div class="users-stat-val" id="statAdmins">—</div>
            </div>
          </div>
          <div class="users-stat" style="margin-left:auto;">
            <div class="users-search-wrap">
              <svg class="users-search-icon" width="14" height="14" fill="none" stroke="#6b7280" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="userSearch" class="users-search-input" placeholder="Search users..." oninput="filterUsers()">
            </div>
            <button class="btn adm-btn adm-btn--blue" onclick="loadUsers()" id="refreshBtn" style="flex-shrink:0;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-1px;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.58"/></svg>
              Refresh
            </button>
          </div>
        </div>

        <!-- Initial load bar (shown before data loads) -->
        <div class="users-load-bar mb-4" id="initialBar">
          <div class="users-search-wrap">
            <svg class="users-search-icon" width="14" height="14" fill="none" stroke="#6b7280" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="userSearchInit" class="users-search-input" placeholder="Search username, email or Discord ID..." oninput="filterUsersInit()" disabled>
          </div>
          <button class="btn adm-btn adm-btn--blue" onclick="loadUsers()" id="refreshBtnInit">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-1px;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.58"/></svg>
            Refresh
          </button>
          <span id="userCount" class="users-count-badge" style="display:none;"></span>
        </div>

        <!-- Table card -->
        <div class="adm-card adm-card--blue" style="overflow:hidden;">
          <div id="userLoading" style="text-align:center;padding:48px;color:#6b7280;font-size:13px;">
            <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 12px;opacity:0.3;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Click <strong>Refresh</strong> to load users
          </div>
          <div id="userTableWrap" style="display:none;overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;font-size:13px;">
              <thead>
                <tr style="border-bottom:1px solid rgba(139,92,246,0.14);">
                  <th style="padding:12px 18px;text-align:left;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">User</th>
                  <th style="padding:12px 18px;text-align:left;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Email</th>
                  <th style="padding:12px 18px;text-align:left;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Discord ID</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Coins</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Plan</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">RAM</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Disk</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">CPU</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Servers</th>
                  <th style="padding:12px 18px;text-align:center;color:#6b7280;font-weight:600;white-space:nowrap;font-size:11px;text-transform:uppercase;letter-spacing:0.6px;">Actions</th>
                </tr>
              </thead>
              <tbody id="userTableBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Management drawer overlay -->
        <div id="drawerOverlay" class="drawer-overlay" onclick="closeDrawer()"></div>
        <div id="mgmtDrawer" class="mgmt-drawer">
          <div class="mgmt-drawer-header">
            <div id="drawerUserInfo" class="mgmt-drawer-user"></div>
            <button class="mgmt-close-btn" onclick="closeDrawer()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <div class="mgmt-drawer-body">

            <!-- Coins -->
            <div class="mgmt-section">
              <div class="mgmt-section-label mgmt-section-label--amber">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Coins
              </div>
              <div class="mgmt-row">
                <input id="inputSetCoins" class="mgmt-input" type="number" min="0" placeholder="Set amount">
                <button class="mgmt-btn mgmt-btn--amber" type="button" onclick="doSetCoins()">Set</button>
              </div>
              <div class="mgmt-row" style="margin-top:8px;">
                <input id="inputAddCoins" class="mgmt-input" type="number" placeholder="±amount">
                <button class="mgmt-btn mgmt-btn--purple" type="button" onclick="doAddCoins()">Add</button>
              </div>
            </div>

            <!-- Plan -->
            <div class="mgmt-section">
              <div class="mgmt-section-label mgmt-section-label--blue">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                Plan
              </div>
              <div class="mgmt-row">
                <select id="selectPlan" class="mgmt-select">
                  <% for (let [pname] of Object.entries(settings.api.client.packages.list)) { %>
                    <option value="<%= pname %>"><%= pname %></option>
                  <% } %>
                </select>
                <button class="mgmt-btn mgmt-btn--blue" type="button" onclick="doSetPlan()">Apply</button>
              </div>
            </div>

            <!-- Resources -->
            <div class="mgmt-section">
              <div class="mgmt-section-label mgmt-section-label--green">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                Set Extra Resources
              </div>
              <div class="mgmt-res-grid">
                <input id="setRam" class="mgmt-input" type="number" min="0" placeholder="RAM (MB)">
                <input id="setDisk" class="mgmt-input" type="number" min="0" placeholder="Disk (MB)">
                <input id="setCpu" class="mgmt-input" type="number" min="0" placeholder="CPU (%)">
                <input id="setSrv" class="mgmt-input" type="number" min="0" placeholder="Servers">
              </div>
              <button class="mgmt-btn mgmt-btn--green" type="button" style="margin-top:10px;width:100%;" onclick="doSetRes()">Set Resources</button>
            </div>

            <!-- Add Resources -->
            <div class="mgmt-section">
              <div class="mgmt-section-label mgmt-section-label--teal">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Extra Resources
              </div>
              <div class="mgmt-res-grid">
                <input id="addRam" class="mgmt-input" type="number" min="0" placeholder="+RAM (MB)">
                <input id="addDisk" class="mgmt-input" type="number" min="0" placeholder="+Disk (MB)">
                <input id="addCpu" class="mgmt-input" type="number" min="0" placeholder="+CPU (%)">
                <input id="addSrv" class="mgmt-input" type="number" min="0" placeholder="+Servers">
              </div>
              <button class="mgmt-btn mgmt-btn--teal" type="button" style="margin-top:10px;width:100%;" onclick="doAddRes()">Add Resources</button>
            </div>

            <!-- Admin toggle -->
            <div class="mgmt-section">
              <div class="mgmt-section-label">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Admin Status
              </div>
              <div style="display:flex;gap:8px;">
                <button class="mgmt-btn mgmt-btn--green" id="btnPromote" type="button" style="flex:1;" onclick="doSetAdmin(true)">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;"><polyline points="20 6 9 17 4 12"/></svg>
                  Promote to Admin
                </button>
                <button class="mgmt-btn mgmt-btn--orange" id="btnDemote" type="button" style="flex:1;" onclick="doSetAdmin(false)">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  Remove Admin
                </button>
              </div>
              <div id="adminStatusBadge" style="margin-top:8px;font-size:11px;font-weight:600;"></div>
            </div>

            <!-- Delete -->
            <div class="mgmt-section mgmt-section--danger">
              <div class="mgmt-section-label mgmt-section-label--red">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                Danger Zone
              </div>
              <button class="mgmt-btn mgmt-btn--red" type="button" style="width:100%;" onclick="doDeleteUser()">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                Remove Account
              </button>
            </div>

          </div>
        </div>

        <!-- Toast -->
        <div id="mgmtToast" class="mgmt-toast"></div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">&copy; <%= settings.name %> &middot; <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> &middot; <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../Components/LoadingBar.ejs') %>

  <script>
    let allUsersData = [];

    async function loadUsers() {
      const loading  = document.getElementById('userLoading');
      const wrap     = document.getElementById('userTableWrap');
      const initBar  = document.getElementById('initialBar');
      const statStrip= document.getElementById('statStrip');
      const btns     = document.querySelectorAll('#refreshBtn,#refreshBtnInit');
      loading.style.display = 'block';
      loading.innerHTML = '<svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 10px;opacity:0.4;animation:spin 1s linear infinite;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.58"/></svg><span style="color:#6b7280;">Loading users...</span>';
      wrap.style.display = 'none';
      btns.forEach(b => b.disabled = true);
      try {
        const res  = await fetch('/admin/usersdata');
        const data = await res.json();
        if (data.error) {
          loading.innerHTML = '<span style="color:#fca5a5;">Error: ' + data.error + '</span>';
          btns.forEach(b => b.disabled = false);
          return;
        }
        allUsersData = data.users;
        // Populate stat strip
        document.getElementById('statTotal').textContent  = allUsersData.length;
        document.getElementById('statCoins').textContent  = allUsersData.reduce((s,u)=>s+u.coins,0).toLocaleString();
        document.getElementById('statAdmins').textContent = allUsersData.filter(u=>u.admin).length;
        // Swap bars
        initBar.style.display   = 'none';
        statStrip.style.display = 'flex';
        renderUsers(allUsersData);
      } catch(e) {
        loading.innerHTML = '<span style="color:#fca5a5;">Failed: ' + e.message + '</span>';
      }
      btns.forEach(b => b.disabled = false);
    }

    const _userMap = {};

    function renderUsers(users) {
      const loading = document.getElementById('userLoading');
      const wrap    = document.getElementById('userTableWrap');
      const tbody   = document.getElementById('userTableBody');
      tbody.innerHTML = '';
      if (!users.length) {
        loading.style.display = 'block';
        loading.innerHTML = '<div style="padding:20px 0;"><svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="display:block;margin:0 auto 12px;opacity:0.2;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span style="color:#4b5563;">No users match your search.</span></div>';
        wrap.style.display = 'none';
        return;
      }
      users.forEach((u, idx) => {
        const key = 'u_' + idx;
        _userMap[key] = u;
        const tr = document.createElement('tr');
        tr.className = 'users-row';
        const cell = (html, cls) => `<td class="users-td${cls?' '+cls:''}">${html}</td>`;
        const totalRam  = (u.packages?.ram  || 0) + (u.extra?.ram  || 0);
        const totalDisk = (u.packages?.disk || 0) + (u.extra?.disk || 0);
        const totalCpu  = (u.packages?.cpu  || 0) + (u.extra?.cpu  || 0);
        const totalServ = (u.packages?.servers||0) + (u.extra?.servers||0);
        tr.innerHTML =
          cell(`<div class="users-user-cell">
            <div class="users-avatar">${u.username.charAt(0).toUpperCase()}</div>
            <div>
              <div class="users-username">${u.username}</div>
              ${u.admin ? '<span class="users-admin-badge">admin</span>' : ''}
            </div>
          </div>`) +
          cell(`<span class="users-email">${u.email}</span>`) +
          cell(u.discordId
            ? `<div>${u.discordUsername ? `<span class="users-discord-name">${u.discordUsername}</span><br>` : ''}<code class="users-discord-id">${u.discordId}</code></div>`
            : `<span class="users-not-linked">Not linked</span>`) +
          cell(`<span class="users-coins">🪙 ${u.coins.toLocaleString()}</span>`, 'center') +
          cell(`<span class="users-plan-badge">${u.plan}</span>`, 'center') +
          cell(`<span class="users-res users-res--green">${totalRam.toLocaleString()} MB</span>`, 'center') +
          cell(`<span class="users-res users-res--blue">${totalDisk.toLocaleString()} MB</span>`, 'center') +
          cell(`<span class="users-res users-res--yellow">${totalCpu}%</span>`, 'center') +
          cell(`<span class="users-res">${totalServ}</span>`, 'center') +
          cell(`<button class="mgmt-open-btn" onclick="openDrawer('${key}')">Manage</button>`, 'center');
        tbody.appendChild(tr);
      });
      loading.style.display = 'none';
      wrap.style.display    = 'block';
    }

    function filterUsers() {
      const q = document.getElementById('userSearch').value.toLowerCase();
      filterByQuery(q);
    }
    function filterUsersInit() {
      const q = document.getElementById('userSearchInit').value.toLowerCase();
      filterByQuery(q);
    }
    function filterByQuery(q) {
      const filtered = allUsersData.filter(u =>
        u.username.toLowerCase().includes(q) ||
        u.email.toLowerCase().includes(q) ||
        (u.discordId && u.discordId.includes(q))
      );
      document.getElementById('statTotal').textContent = filtered.length + ' / ' + allUsersData.length;
      renderUsers(filtered);
    }

    let _activeUserId = null;

    function openDrawer(key) {
      const u = _userMap[key];
      if (!u) return;
      _activeUserId = u.discordId;
      // header
      document.getElementById('drawerUserInfo').innerHTML =
        `<div class="users-avatar" style="width:36px;height:36px;font-size:14px;">${u.username.charAt(0).toUpperCase()}</div>
         <div>
           <div style="font-weight:700;font-size:14px;color:#e2e8f0;">${u.username}</div>
           <div style="font-size:11px;color:#6b7280;">${u.discordId || 'No Discord'}</div>
         </div>`;
      // pre-fill coin input
      document.getElementById('inputSetCoins').value  = u.coins;
      document.getElementById('inputAddCoins').value  = '';
      // admin status
      const badge = document.getElementById('adminStatusBadge');
      if (u.admin) {
        badge.innerHTML = '<span style="color:#fcd34d;">⚡ Currently Admin</span>';
        document.getElementById('btnPromote').disabled = true;
        document.getElementById('btnDemote').disabled  = false;
      } else {
        badge.innerHTML = '<span style="color:#6b7280;">Not an admin</span>';
        document.getElementById('btnPromote').disabled = false;
        document.getElementById('btnDemote').disabled  = true;
      }
      // open
      document.getElementById('drawerOverlay').classList.add('active');
      document.getElementById('mgmtDrawer').classList.add('open');
    }

    function closeDrawer() {
      document.getElementById('drawerOverlay').classList.remove('active');
      document.getElementById('mgmtDrawer').classList.remove('open');
    }

    function showToast(msg, ok) {
      const t = document.getElementById('mgmtToast');
      t.textContent = msg;
      t.className = 'mgmt-toast ' + (ok ? 'mgmt-toast--ok' : 'mgmt-toast--err') + ' mgmt-toast--show';
      clearTimeout(t._tid);
      t._tid = setTimeout(() => t.classList.remove('mgmt-toast--show'), 3000);
    }

    async function doSetAdmin(makeAdmin) {
      const u = _userMap[Object.keys(_userMap).find(k => _userMap[k].discordId === _activeUserId)];
      if (!u) return showToast('User not found', false);
      try {
        const res = await fetch('/admin/setadmin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pteroId: u.id, admin: makeAdmin })
        });
        const data = await res.json();
        if (data.success) {
          u.admin = makeAdmin;
          const badge = document.getElementById('adminStatusBadge');
          if (makeAdmin) {
            badge.innerHTML = '<span style="color:#fcd34d;">⚡ Currently Admin</span>';
            document.getElementById('btnPromote').disabled = true;
            document.getElementById('btnDemote').disabled  = false;
          } else {
            badge.innerHTML = '<span style="color:#6b7280;">Not an admin</span>';
            document.getElementById('btnPromote').disabled = false;
            document.getElementById('btnDemote').disabled  = true;
          }
          showToast(makeAdmin ? 'Promoted to admin' : 'Admin removed', true);
          renderUsers(allUsersData);
        } else {
          showToast('Error: ' + (data.error || 'Unknown'), false);
        }
      } catch(e) { showToast('Request failed', false); }
    }

    async function postForm(url, body) {
      const fd = new FormData();
      Object.entries(body).forEach(([k,v]) => fd.append(k, v));
      const res = await fetch(url, { method:'POST', body: fd, redirect:'manual' });
      return res.ok || res.status === 0 || res.type === 'opaqueredirect';
    }

    function doSetCoins() {
      const v = document.getElementById('inputSetCoins').value;
      if (v === '' || !_activeUserId) return;
      fetch(`/setcoins?id=${encodeURIComponent(_activeUserId)}&coins=${encodeURIComponent(v)}`, { redirect:'manual' })
        .then(() => { showToast('Coins set to ' + v, true); loadUsers(); })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    function doAddCoins() {
      const v = document.getElementById('inputAddCoins').value;
      if (v === '' || !_activeUserId) return;
      fetch(`/addcoins?id=${encodeURIComponent(_activeUserId)}&coins=${encodeURIComponent(v)}`, { redirect:'manual' })
        .then(() => { showToast('Coins adjusted by ' + v, true); loadUsers(); })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    function doSetPlan() {
      const pkg = document.getElementById('selectPlan').value;
      if (!pkg || !_activeUserId) return;
      postForm('/setplan', { id: _activeUserId, package: pkg })
        .then(ok => { showToast(ok ? 'Plan set to ' + pkg : 'Failed to set plan', ok); if (ok) loadUsers(); })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    function doSetRes() {
      if (!_activeUserId) return;
      const body = { id: _activeUserId };
      const ram = document.getElementById('setRam').value;
      const disk = document.getElementById('setDisk').value;
      const cpu = document.getElementById('setCpu').value;
      const srv = document.getElementById('setSrv').value;
      if (ram !== '') body.ram = ram;
      if (disk !== '') body.disk = disk;
      if (cpu !== '') body.cpu = cpu;
      if (srv !== '') body.servers = srv;
      postForm('/setresources', body)
        .then(ok => { showToast(ok ? 'Resources updated' : 'Failed to set resources', ok); if (ok) loadUsers(); })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    function doAddRes() {
      if (!_activeUserId) return;
      const body = { id: _activeUserId };
      const ram = document.getElementById('addRam').value;
      const disk = document.getElementById('addDisk').value;
      const cpu = document.getElementById('addCpu').value;
      const srv = document.getElementById('addSrv').value;
      if (ram !== '') body.ram = ram;
      if (disk !== '') body.disk = disk;
      if (cpu !== '') body.cpu = cpu;
      if (srv !== '') body.servers = srv;
      postForm('/addresources', body)
        .then(ok => { showToast(ok ? 'Resources added' : 'Failed to add resources', ok); if (ok) loadUsers(); })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    function doDeleteUser() {
      if (!_activeUserId) return;
      if (!confirm('Remove this user from the database? This cannot be undone.')) return;
      postForm('/remove_account', { id: _activeUserId })
        .then(ok => {
          showToast(ok ? 'User removed' : 'Failed to remove user', ok);
          if (ok) { closeDrawer(); loadUsers(); }
        })
        .catch(e => showToast('Error: ' + e.message, false));
    }

    loadUsers();
  </script>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }

    /* tabs */
    .adm-page-header { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px; }
    .adm-tab-nav { display:flex;gap:4px;background:rgba(255,255,255,.03);border:1px solid rgba(139,92,246,.14);border-radius:12px;padding:4px; }
    .adm-tab { display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:9px;font-size:12px;font-weight:600;color:#6b7280;text-decoration:none;transition:all .15s; }
    .adm-tab:hover { color:#c4b5fd;background:rgba(124,58,237,.08);text-decoration:none; }
    .adm-tab--active { background:rgba(124,58,237,.18);color:#c4b5fd;border:1px solid rgba(124,58,237,.25); }

    /* stat strip */
    .users-stat-strip { display:flex;align-items:center;gap:0;background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;flex-wrap:wrap; }
    .users-stat { display:flex;align-items:center;gap:12px;padding:14px 20px;border-right:1px solid var(--border);flex-shrink:0; }
