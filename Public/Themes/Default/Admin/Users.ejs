    .mgmt-section-label--purple { color:#c4b5fd; }
    .mgmt-section-label--blue   { color:#93c5fd; }
    .mgmt-section-label--green  { color:#6ee7b7; }
    .mgmt-section-label--teal   { color:#5eead4; }
