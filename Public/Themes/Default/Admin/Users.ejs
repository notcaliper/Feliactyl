    .users-stat-icon { width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
    .users-stat-icon--purple { background:rgba(124,58,237,.12); }
    .users-stat-icon--amber  { background:rgba(245,158,11,.12); }
    .users-stat-icon--red    { background:rgba(220,38,38,.12); }
    .users-stat-label { font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.6px;font-weight:600; }
    .users-stat-val   { font-size:17px;font-weight:800;color:#e2e8f0;margin-top:1px; }

    /* initial load bar */
    .users-load-bar { display:flex;align-items:center;gap:10px; }
    .users-count-badge { font-size:12px;color:#6b7280; }

    /* search */
    .users-search-wrap { position:relative;display:flex;align-items:center; }
    .users-search-icon { position:absolute;left:11px;pointer-events:none;flex-shrink:0; }
    .users-search-input { background:var(--surface2);border:1px solid rgba(139,92,246,.18);border-radius:9px;color:#e2e8f0;font-size:13px;padding:9px 12px 9px 34px;outline:none;font-family:inherit;min-width:260px;transition:border-color .15s; }
    .users-search-input::placeholder { color:#4b4669; }
    .users-search-input:focus { border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.12); }
    .users-search-input:disabled { opacity:.4;cursor:not-allowed; }

    /* buttons */
    .adm-btn { font-size:13px!important;font-weight:600!important;padding:9px 18px!important;border:none!important;border-radius:9px!important;display:inline-flex;align-items:center;transition:all 0.15s!important; }
    .adm-btn:hover { transform:translateY(-1px)!important;filter:brightness(1.1)!important; }
    .adm-btn--blue  { background:linear-gradient(135deg,#2563eb,#60a5fa)!important;color:white!important;box-shadow:0 2px 10px rgba(37,99,235,0.3)!important; }
    .adm-btn:disabled { opacity:0.6!important;cursor:not-allowed!important;transform:none!important; }

    /* card */
    .adm-card { background:var(--surface);border-radius:16px;overflow:hidden;position:relative;border:1px solid rgba(139,92,246,0.14); }
    .adm-card::before { content:'';position:absolute;inset:0 0 auto 0;height:3px;border-radius:16px 16px 0 0; }
    .adm-card--blue::before { background:linear-gradient(90deg,#2563eb,#60a5fa); }

    /* table */
    .users-row { border-bottom:1px solid rgba(139,92,246,.07);transition:background .12s;cursor:default; }
    .users-row:hover { background:rgba(139,92,246,.04); }
    .users-row:last-child { border-bottom:none; }
    .users-td { padding:11px 18px;color:#e2e8f0;white-space:nowrap; }
    .users-td.center { text-align:center; }
    .users-user-cell { display:flex;align-items:center;gap:9px; }
    .users-avatar { width:32px;height:32px;border-radius:9px;background:rgba(124,58,237,.18);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#a78bfa;flex-shrink:0; }
    .users-username { font-weight:600;font-size:13px;color:#e2e8f0; }
    .users-admin-badge { font-size:10px;background:rgba(220,38,38,.14);color:#fca5a5;border-radius:4px;padding:1px 6px;display:inline-block;margin-top:2px; }
    .users-email { color:#6b7280;font-size:12px; }
    .users-discord-name { font-size:12px;color:#c4b5fd;font-weight:600; }
    .users-discord-id { font-size:10px;color:#6b7280;background:rgba(124,58,237,.08);padding:1px 6px;border-radius:4px; }
    .users-not-linked { color:#374151;font-size:12px; }
    .users-coins { font-weight:700;color:#fbbf24; }
    .users-plan-badge { font-size:11px;background:rgba(124,58,237,.12);color:#c4b5fd;border-radius:5px;padding:3px 10px;font-weight:600; }
    .users-res { font-size:12px;font-weight:600;color:#9ca3af; }
    .users-res--green  { color:#6ee7b7; }
    .users-res--blue   { color:#93c5fd; }
    .users-res--yellow { color:#fcd34d; }

    /* manage button */
    .mgmt-open-btn { background:rgba(139,92,246,.14);border:1px solid rgba(139,92,246,.28);color:#c4b5fd;font-size:11px;font-weight:700;padding:5px 14px;border-radius:7px;cursor:pointer;transition:all .14s;white-space:nowrap; }
    .mgmt-open-btn:hover { background:rgba(139,92,246,.28);color:#e9d5ff;transform:translateY(-1px); }

    /* drawer overlay */
    .drawer-overlay { position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:900;opacity:0;pointer-events:none;transition:opacity .2s; }
    .drawer-overlay.active { opacity:1;pointer-events:all; }

    /* drawer panel */
    .mgmt-drawer { position:fixed;top:0;right:0;height:100vh;width:380px;max-width:100vw;background:#13111c;border-left:1px solid rgba(139,92,246,.2);z-index:901;transform:translateX(100%);transition:transform .25s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden; }
    .mgmt-drawer.open { transform:translateX(0); }
    .mgmt-drawer-header { display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid rgba(139,92,246,.14);flex-shrink:0; }
    .mgmt-drawer-user { display:flex;align-items:center;gap:12px; }
    .mgmt-close-btn { background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.2);color:#a78bfa;width:32px;height:32px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .14s; }
