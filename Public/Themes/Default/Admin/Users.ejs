    .mgmt-drawer-body { flex:1;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:16px; }

    /* drawer sections */
    .mgmt-section { background:rgba(255,255,255,.03);border:1px solid rgba(139,92,246,.1);border-radius:12px;padding:14px 16px; }
    .mgmt-section--danger { border-color:rgba(220,38,38,.2);background:rgba(220,38,38,.04); }
