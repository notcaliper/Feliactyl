<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>
<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">
        <style>
          .cs-steps { display:flex; align-items:center; gap:0; margin-bottom:28px; }
          .cs-step {
            display:flex; align-items:center; gap:10px; cursor:pointer;
            padding:10px 18px; border-radius:10px; font-size:13px; font-weight:500;
            color:#5b4f85; transition:all 0.15s; user-select:none;
          }
          .cs-step.active { background:rgba(109,40,217,0.18); color:#c4b5fd; }
          .cs-step.active .cs-step-num { background:linear-gradient(135deg,#6d28d9,#4f46e5); color:white; box-shadow:0 0 10px rgba(109,40,217,0.5); }
          .cs-step-num {
            width:26px; height:26px; border-radius:50%;
            background:rgba(139,92,246,0.1); color:#5b4f85;
            display:flex; align-items:center; justify-content:center;
            font-size:11px; font-weight:700; flex-shrink:0; transition:all 0.15s;
          }
          .cs-step-arrow { color:#3d3160; font-size:16px; padding:0 2px; }
          .cs-progress { height:6px; border-radius:9999px; background:rgba(139,92,246,0.08); overflow:hidden; margin:8px 2px 20px; }
          .cs-progress-bar { height:100%; width:0%; background:linear-gradient(90deg,#6d28d9,#4f46e5); box-shadow:0 0 12px rgba(109,40,217,0.5) inset; transition:width .2s ease; }
          .cs-panel { display:none; }
          .cs-panel.active { display:block; }
          .cs-field { margin-bottom:20px; }
          .cs-field label { display:block; font-size:12px; font-weight:600; color:#7c6faa; margin-bottom:8px; text-transform:uppercase; letter-spacing:.6px; }
          .cs-input {
            width:100%; max-width:480px; padding:11px 14px;
            background:rgba(109,40,217,0.07); border:1px solid rgba(139,92,246,0.2);
            border-radius:9px; color:#e2d9f3; font-size:14px; outline:none;
            transition:border-color 0.15s;
          }
          .cs-input:focus { border-color:rgba(139,92,246,0.6); background:rgba(109,40,217,0.12); }
          .cs-input option { background:#14112a; }
          .cs-hint { font-size:11px; color:#3d3160; margin-top:6px; }
          .cs-chips { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
          .chip { padding:6px 10px; border-radius:9999px; font-size:12px; color:#c4b5fd; cursor:pointer;
                  border:1px solid rgba(139,92,246,0.25); background:rgba(109,40,217,0.1); }
          .chip:hover { border-color:rgba(139,92,246,0.5); }
          .cs-loc-grid { display:flex; flex-wrap:wrap; gap:14px; }
          .cs-loc-card {
            position:relative; cursor:pointer;
            border:2px solid rgba(139,92,246,0.15); border-radius:12px; overflow:hidden;
            transition:border-color 0.15s, box-shadow 0.15s; flex-shrink:0;
          }
          .cs-loc-card:hover { border-color:rgba(139,92,246,0.4); }
          .cs-loc-card.selected { border-color:#7c3aed; box-shadow:0 0 16px rgba(124,58,237,0.3); }
          .cs-loc-card input { position:absolute; opacity:0; width:0; height:0; }
          .cs-loc-card img { width:240px; height:140px; object-fit:cover; display:block; }
          .cs-loc-fallback { width:240px; height:140px; display:none; align-items:center; justify-content:center; flex-direction:column;
                              background: radial-gradient(120% 120% at 50% 0%, rgba(124,58,237,0.25) 0%, rgba(14,11,30,0.85) 60%);
                              color:#e2d9f3; text-align:center; padding:12px; gap:6px; }
          .cs-loc-fallback .title { font-weight:700; letter-spacing:-0.2px; }
          .cs-loc-fallback .desc { font-size:12px; color:#a899cc; }
          .cs-loc-tick { position:absolute; top:8px; right:8px; width:22px; height:22px; border-radius:50%;
                          background:linear-gradient(135deg,#6d28d9,#4f46e5); color:#fff; display:none; align-items:center; justify-content:center;
                          font-size:12px; box-shadow:0 0 12px rgba(109,40,217,0.5); }
          .cs-loc-card.selected .cs-loc-tick { display:flex; }
          .cs-loc-label { padding:8px 12px; font-size:12px; font-weight:600; color:#a899cc; background:rgba(14,11,30,0.8); }
          .cs-footer { display:flex; align-items:center; justify-content:space-between; margin-top:28px; padding-top:20px; border-top:1px solid rgba(139,92,246,0.08); }
          .cs-error { background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); border-radius:10px; padding:12px 16px; color:#fca5a5; font-size:13px; margin-bottom:20px; }
        </style>

        <div class="page-header">
          <div class="page-title">Create Server</div>
          <div class="page-subtitle">Configure and deploy a new server</div>
        </div>

        <% if (req.query.err) { %>
        <div class="cs-error">
          ⚠️
          <% if (req.query.err == "MISSINGVARIABLE") { %>You have not filled out all of the server information.
          <% } else if (req.query.err == "NOTANUMBER") { %>RAM, disk and CPU must be a number.
          <% } else if (req.query.err == "ERRORONCREATE") { %>Failed to create the server. The panel returned an error.
          <% } else if (req.query.err == "BIGSERVERNAME") { %>Server name must be less than <strong>191</strong> characters.
          <% } else if (req.query.err == "TOOMUCHSERVERS") { %>You've reached your server limit.
          <% } else if (req.query.err == "PREMIUMLOCATION") { %>Your plan doesn't have access to that location.
          <% } else if (req.query.err == "TOOLITTLECOINS") { %>Not enough coins to create a server.
          <% } else if (req.query.err == "EXCEEDRAM" || req.query.err == "EXCEEDDISK" || req.query.err == "EXCEEDCPU") { %>Not enough resources available.
          <% } else { %>Something went wrong. Please try again.
          <% } %>
        </div>
        <% } %>

        <!-- Steps -->
        <div class="cs-steps">
          <div class="cs-step active" id="step-1" onclick="goStep(1)"><span class="cs-step-num">1</span> Name</div>
          <span class="cs-step-arrow">›</span>
          <div class="cs-step" id="step-2" onclick="goStep(2)"><span class="cs-step-num">2</span> Resources</div>
          <span class="cs-step-arrow">›</span>
          <div class="cs-step" id="step-3" onclick="goStep(3)"><span class="cs-step-num">3</span> Disk</div>
          <span class="cs-step-arrow">›</span>
          <div class="cs-step" id="step-4" onclick="goStep(4)"><span class="cs-step-num">4</span> Location</div>
          <span class="cs-step-arrow">›</span>
          <div class="cs-step" id="step-5" onclick="goStep(5)"><span class="cs-step-num">5</span> Software</div>
        </div>
        <div class="cs-progress"><div class="cs-progress-bar" id="cs-progress"></div></div>

        <!-- Panels -->
        <div class="card">
          <div class="card-body">

            <div class="cs-panel active" id="panel-1">
              <div class="cs-field">
                <label>Server Name</label>
                <input class="cs-input" type="text" id="InputName" placeholder="My awesome server">
                <div class="cs-hint">Give your server a unique name (max 191 characters)</div>
              </div>
            </div>

            <div class="cs-panel" id="panel-2">
              <div class="row g-3">
                <div class="col-md-6">
                  <% const _maxRam = packages.ram + extraresources.ram; %>
                  <div class="cs-field">
                    <label>RAM (MB)</label>
                    <input class="cs-input" type="number" id="InputRAM" placeholder="e.g. 1024">
                    <div class="cs-hint">Available: <%= _maxRam %> MB</div>
                    <div class="cs-chips">
                      <span class="chip" onclick="setVal('InputRAM',<%= Math.floor(_maxRam*0.25) %>)">25%</span>
                      <span class="chip" onclick="setVal('InputRAM',<%= Math.floor(_maxRam*0.50) %>)">50%</span>
                      <span class="chip" onclick="setVal('InputRAM',<%= Math.floor(_maxRam*0.75) %>)">75%</span>
                      <span class="chip" onclick="setVal('InputRAM',<%= _maxRam %>)">100%</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <% const _maxCpu = packages.cpu + extraresources.cpu; %>
                  <div class="cs-field">
                    <label>CPU (%)</label>
                    <input class="cs-input" type="number" id="InputCPU" placeholder="e.g. 100">
                    <div class="cs-hint">Available: <%= _maxCpu %>%</div>
                    <div class="cs-chips">
                      <span class="chip" onclick="setVal('InputCPU',<%= Math.floor(_maxCpu*0.25) %>)">25%</span>
                      <span class="chip" onclick="setVal('InputCPU',<%= Math.floor(_maxCpu*0.50) %>)">50%</span>
                      <span class="chip" onclick="setVal('InputCPU',<%= Math.floor(_maxCpu*0.75) %>)">75%</span>
                      <span class="chip" onclick="setVal('InputCPU',<%= _maxCpu %>)">100%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="cs-panel" id="panel-3">
              <% const _maxDisk = packages.disk + extraresources.disk; %>
              <div class="cs-field">
                <label>Disk Size (MB)</label>
                <input class="cs-input" type="number" id="InputDisk" placeholder="e.g. 5120">
                <div class="cs-hint">Available: <%= _maxDisk %> MB</div>
                <div class="cs-chips">
                  <span class="chip" onclick="setVal('InputDisk',<%= Math.floor(_maxDisk*0.25) %>)">25%</span>
                  <span class="chip" onclick="setVal('InputDisk',<%= Math.floor(_maxDisk*0.50) %>)">50%</span>
                  <span class="chip" onclick="setVal('InputDisk',<%= Math.floor(_maxDisk*0.75) %>)">75%</span>
                  <span class="chip" onclick="setVal('InputDisk',<%= _maxDisk %>)">100%</span>
                </div>
              </div>
            </div>

            <div class="cs-panel" id="panel-4">
              <div class="cs-field">
                <label>Select Location</label>
                <script>let inputLOCC = "";</script>
                <div class="cs-loc-grid">
                  <% for (let [name, value] of Object.entries(settings.api.client.locations)) { %>
                  <label class="cs-loc-card" id="loc-<%= name %>" onclick="selectLoc('<%= name %>', this)">
                    <input type="radio" name="InputLoc" value="<%= name %>">
                    <img src="<%= value.banner %>" alt="<%= value.name || name %>" onerror="this.style.display='none'; this.parentNode.querySelector('.cs-loc-fallback').style.display='flex';">
                    <div class="cs-loc-fallback">
                      <svg width="28" height="28" fill="none" stroke="#7c3aed" stroke-width="1.5" viewBox="0 0 24 24" style="margin-bottom:4px;opacity:0.6;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
                      <div class="title"><%= value.name || ('Location ' + name) %></div>
                      <div class="desc">ID: <%= name %></div>
                    </div>
                    <div class="cs-loc-tick">✓</div>
                    <div class="cs-loc-label">
                      <span style="color:#e2d9f3;font-weight:700;"><%= value.name || ('Location ' + name) %></span>
                      <span style="color:#4b4669;font-size:10px;margin-left:6px;">ID: <%= name %></span>
                    </div>
                  </label>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="cs-panel" id="panel-5">
              <div class="cs-field">
                <label>Server Software</label>
                <select class="cs-input" id="InputEgg">
                  <% for (let [name, value] of Object.entries(settings.api.client.eggs)) { %>
                    <option value="<%= name %>"><%= value.display %></option>
                  <% } %>
                </select>
                <div class="cs-hint">Choose the game or application you want to run</div>
              </div>
            </div>

            <!-- Footer nav -->
            <div class="cs-footer">
              <button class="btn btn-secondary" id="btn-prev" onclick="goStep(currentStep-1)" style="display:none;">← Back</button>
              <div style="flex:1;"></div>
              <button class="btn btn-primary" id="btn-next" onclick="goStep(currentStep+1)">Next →</button>
              <button class="btn btn-primary" id="btn-create" onclick="submitNew()" style="display:none;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-right:6px;"><polyline points="20 6 9 17 4 12"/></svg>
                Create Server
              </button>
            </div>

          </div>
        </div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script>
    let currentStep = 1;
    const totalSteps = 5;

    function goStep(n) {
      if (n < 1 || n > totalSteps) return;
      document.getElementById('panel-' + currentStep).classList.remove('active');
      document.getElementById('step-' + currentStep).classList.remove('active');
      currentStep = n;
      document.getElementById('panel-' + currentStep).classList.add('active');
      document.getElementById('step-' + currentStep).classList.add('active');
      document.getElementById('btn-prev').style.display = currentStep > 1 ? 'inline-flex' : 'none';
      document.getElementById('btn-next').style.display = currentStep < totalSteps ? 'inline-flex' : 'none';
      document.getElementById('btn-create').style.display = currentStep === totalSteps ? 'inline-flex' : 'none';
      // progress
      const pct = ((currentStep - 1) / (totalSteps - 1)) * 100;
      const bar = document.getElementById('cs-progress');
      if (bar) bar.style.width = pct + '%';
    }

    function selectLoc(name, el) {
      inputLOCC = name;
      document.querySelectorAll('.cs-loc-card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
    }

    async function submitNew() {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/create';
      const fields = {
        name:     document.getElementById("InputName").value,
        egg:      document.getElementById("InputEgg").value,
        ram:      document.getElementById("InputRAM").value,
        disk:     document.getElementById("InputDisk").value,
        cpu:      document.getElementById("InputCPU").value,
        location: inputLOCC
      };
      for (const [k, v] of Object.entries(fields)) {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = k; i.value = v;
        form.appendChild(i);
      }
      document.body.appendChild(form);
      form.submit();
    }

    function setVal(id, v){ const el = document.getElementById(id); if(el){ el.value = v; el.dispatchEvent(new Event('input')); } }

    goStep(1);
  </script>

  <%- include('../../Components/LoadingBar.ejs') %>
</body>
</html>