<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">

        <% if (req.query.err && req.query.err !== 'none') { %>
        <% const _giftErrors = { 'MISSINGID':'Please enter a Discord ID.','INVALIDID':'User not found.','NOTENOUGHCOINS':'Not enough coins.','MISSINGCOINS':'Please enter an amount.' }; %>
        <div class="alert-banner alert-banner--red mb-4"><%= _giftErrors[req.query.err] || ('Error: ' + req.query.err) %></div>
        <% } else if (req.query.err === 'none') { %>
        <div class="alert-banner alert-banner--green mb-4">Coins gifted successfully!</div>
        <% } %>

        <!-- Page header -->
        <div class="page-header">
          <div class="page-title">Gift Coins</div>
          <div class="page-subtitle">Send coins to another user by their Discord ID 🎁</div>
        </div>

        <div class="row g-4">

          <!-- Gift form card -->
          <div class="col-12 col-lg-6">
            <div class="gift-card">
              <div class="gift-card-header">
                <div class="gift-card-icon">
                  <svg width="18" height="18" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 12 20 22 4 22 4 12"/>
                    <rect x="2" y="7" width="20" height="5"/>
                    <path d="M12 22V7"/>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                  </svg>
                </div>
                <div>
                  <div class="gift-card-title">Send a Gift</div>
                  <div class="gift-card-sub">Enter the recipient's Discord ID and amount</div>
                </div>
              </div>

              <div class="gift-field">
                <label for="InputID">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-1px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  Discord ID
                </label>
                <input type="number" class="form-control gift-input" id="InputID" placeholder="000000000000000000" autocomplete="off">
                <div class="gift-hint">18-digit Discord user ID</div>
              </div>

              <div class="gift-field">
                <label for="InputCoins">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-1px;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  Amount
                </label>
                <div class="gift-input-wrap">
                  <span class="gift-input-prefix">🪙</span>
                  <input type="number" class="form-control gift-input gift-input-coins" id="InputCoins" placeholder="100" min="1" autocomplete="off">
                </div>
                <div class="gift-hint">Your balance: <span class="gift-balance">🪙 <span id="balanceDisplay"></span></span></div>
              </div>

              <button class="btn btn-primary gift-btn" onclick="submitGift()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:-2px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Send Gift
              </button>
            </div>
          </div>

          <!-- Info card -->
          <div class="col-12 col-lg-6">
            <div class="gift-info-card">
              <div class="gift-info-title">How gifting works</div>
              <ul class="gift-info-list">
                <li>
                  <div class="gift-info-dot gift-info-dot--purple"></div>
                  <span>Enter the recipient's <strong>Discord User ID</strong> (not username)</span>
                </li>
                <li>
                  <div class="gift-info-dot gift-info-dot--blue"></div>
                  <span>Choose how many <strong>coins</strong> you want to send</span>
                </li>
                <li>
                  <div class="gift-info-dot gift-info-dot--green"></div>
                  <span>Coins are <strong>transferred instantly</strong> and cannot be undone</span>
                </li>
                <li>
                  <div class="gift-info-dot gift-info-dot--amber"></div>
                  <span>You cannot gift more coins than your <strong>current balance</strong></span>
                </li>
              </ul>
            </div>
          </div>

        </div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · Powered by <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../../Components/LoadingBar.ejs') %>

  <script>
    const _bal = Math.floor(<%= coins %> * 100) / 100;
    document.getElementById('balanceDisplay').textContent = _bal;

    async function submitGift() {
      const id    = encodeURIComponent(document.getElementById('InputID').value.trim());
      const coins = encodeURIComponent(document.getElementById('InputCoins').value.trim());
      if (!id || !coins) return;
      document.location.href = `/giftcoins?id=${id}&coins=${coins}`;
    }

    document.getElementById('InputCoins').addEventListener('keydown', e => {
      if (e.key === 'Enter') submitGift();
    });
  </script>

  <style>
    /* ── Gift card ── */
    .gift-card {
      background: var(--surface);
      border: 1px solid rgba(139,92,246,0.18);
      border-radius: 16px;
      padding: 0;
      overflow: hidden;
      position: relative;
    }
    .gift-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: linear-gradient(90deg, #7c3aed, #a78bfa, #ec4899);
      border-radius: 16px 16px 0 0;
    }

    .gift-card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 22px 24px 18px;
      border-bottom: 1px solid rgba(139,92,246,0.1);
    }
    .gift-card-icon {
      width: 42px; height: 42px; flex-shrink: 0;
      border-radius: 11px;
      background: rgba(124,58,237,0.15);
      border: 1px solid rgba(124,58,237,0.25);
      display: flex; align-items: center; justify-content: center;
    }
    .gift-card-title {
      font-size: 14px; font-weight: 700; color: #e2e8f0;
    }
    .gift-card-sub {
      font-size: 12px; color: #6b5f8a; margin-top: 2px;
    }

    /* fields */
    .gift-field {
      padding: 18px 24px 0;
    }
    .gift-field label {
      font-size: 12px !important;
      font-weight: 600 !important;
      color: #9d8ec7 !important;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      margin-bottom: 8px !important;
      display: block;
    }
    .gift-input {
      background: var(--surface2) !important;
      border: 1px solid rgba(139,92,246,0.2) !important;
      border-radius: 10px !important;
      color: white !important;
      font-size: 14px !important;
      padding: 11px 14px !important;
      width: 100% !important;
      transition: border-color 0.15s, box-shadow 0.15s !important;
    }
    .gift-input:focus {
      border-color: #7c3aed !important;
      box-shadow: 0 0 0 3px rgba(124,58,237,0.15) !important;
      outline: none !important;
    }
    .gift-input-wrap {
      position: relative;
    }
    .gift-input-prefix {
      position: absolute;
      left: 12px; top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      pointer-events: none;
      z-index: 1;
    }
    .gift-input-coins {
      padding-left: 34px !important;
    }
    .gift-hint {
      font-size: 11px;
      color: #4b4669;
      margin-top: 6px;
    }
    .gift-balance {
      color: #a78bfa;
      font-weight: 600;
    }

    /* submit button */
    .gift-btn {
      margin: 20px 24px 24px;
      width: calc(100% - 48px);
      padding: 11px !important;
      font-size: 13px !important;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ── Info card ── */
    .gift-info-card {
      background: rgba(124,58,237,0.06);
      border: 1px solid rgba(124,58,237,0.16);
      border-radius: 16px;
      padding: 22px 24px;
      height: 100%;
    }
    .gift-info-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.9px;
      color: #7c6faa;
      margin-bottom: 18px;
    }
    .gift-info-list {
      list-style: none;
      padding: 0; margin: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .gift-info-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 13px;
      color: #9d8ec7;
      line-height: 1.55;
    }
    .gift-info-list li strong { color: #c4b5fd; font-weight: 600; }
    .gift-info-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 5px;
    }
    .gift-info-dot--purple { background: #7c3aed; }
    .gift-info-dot--blue   { background: #3b82f6; }
    .gift-info-dot--green  { background: #10b981; }
    .gift-info-dot--amber  { background: #f59e0b; }
  </style>

</body>
</html>