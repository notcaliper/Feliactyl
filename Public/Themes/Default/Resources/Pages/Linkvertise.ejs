<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">

        <!-- Page header -->
        <div class="page-header">
          <div class="page-title">Linkvertise</div>
          <div class="page-subtitle">Generate a link, complete it, and earn coins instantly 🔗</div>
        </div>

        <% if (req.query.success === 'true') { %>
        <div class="alert-banner alert-banner--green mb-4">✓ Link completed! Coins have been added to your account.</div>
        <% } else if (req.query.err === 'REACHEDDAILYLIMIT') { %>
        <div class="alert-banner alert-banner--red mb-4">You've reached the daily Linkvertise limit. Come back in 12 hours.</div>
        <% } else if (req.query.err) { %>
        <div class="alert-banner alert-banner--red mb-4">Error: <%= req.query.err %></div>
        <% } %>

        <div class="row g-4">

          <!-- Action card -->
          <div class="col-12 col-lg-5">
            <div class="lv-card">
              <div class="lv-card-header">
                <div class="lv-card-icon">
                  <svg width="18" height="18" fill="none" stroke="#93c5fd" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                  </svg>
                </div>
                <div>
                  <div class="lv-card-title">Linkvertise Earning</div>
                  <div class="lv-card-sub">Complete links to earn coins</div>
                </div>
              </div>

              <!-- Reward highlight -->
              <div class="lv-reward-wrap">
                <div class="lv-reward-num">🪙 <%= settings.linkvertise.coins %></div>
                <div class="lv-reward-desc">coins per completed link</div>
              </div>

              <!-- CTA -->
              <div class="lv-cta-wrap">
                <a href="../lv/gen" class="btn btn-primary lv-btn">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:-2px;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Generate Link
                </a>
                <div class="lv-cta-hint">A unique link will be generated for you</div>
              </div>
            </div>
          </div>

          <!-- Stats + steps -->
          <div class="col-12 col-lg-7">

            <!-- Reward stat card -->
            <div class="row g-3 mb-3">
              <div class="col-6">
                <div class="sc sc--blue">
                  <div class="sc-top">
                    <div class="sc-icon sc-icon--blue">
                      <svg width="16" height="16" fill="none" stroke="#93c5fd" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    </div>
                    <span class="sc-badge sc-badge--blue">per link</span>
                  </div>
                  <div class="sc-value"><%= settings.linkvertise.coins %><span class="sc-unit"> coins</span></div>
                  <div class="sc-label">Reward</div>
                  <div class="sc-bar-track"><div class="sc-bar sc-bar--blue" style="width:100%"></div></div>
                  <div class="sc-sub">per completed link</div>
                </div>
              </div>
              <div class="col-6">
                <div class="sc sc--purple">
                  <div class="sc-top">
                    <div class="sc-icon sc-icon--purple">
                      <svg width="16" height="16" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                    <span class="sc-badge sc-badge--purple">balance</span>
                  </div>
                  <div class="sc-value"><%= Math.floor(coins * 100) / 100 %><span class="sc-unit"> 🪙</span></div>
                  <div class="sc-label">Your Coins</div>
                  <div class="sc-bar-track"><div class="sc-bar sc-bar--purple" style="width:60%"></div></div>
                  <div class="sc-sub"><%= packagename.charAt(0).toUpperCase() + packagename.slice(1) %> plan</div>
                </div>
              </div>
            </div>

            <!-- Steps card -->
            <div class="lv-steps-card">
              <div class="lv-steps-title">How it works</div>
              <div class="lv-steps">

                <div class="lv-step">
                  <div class="lv-step-num lv-step-num--blue">1</div>
                  <div class="lv-step-body">
                    <div class="lv-step-head">Generate a Link</div>
                    <div class="lv-step-desc">Click the button to get a unique Linkvertise URL</div>
                  </div>
                </div>

                <div class="lv-step-divider"></div>

                <div class="lv-step">
                  <div class="lv-step-num lv-step-num--purple">2</div>
                  <div class="lv-step-body">
                    <div class="lv-step-head">Complete the Link</div>
                    <div class="lv-step-desc">Follow the Linkvertise steps — takes around 30 seconds</div>
                  </div>
                </div>

                <div class="lv-step-divider"></div>

                <div class="lv-step">
                  <div class="lv-step-num lv-step-num--green">3</div>
                  <div class="lv-step-body">
                    <div class="lv-step-head">Coins Added</div>
                    <div class="lv-step-desc"><strong><%= settings.linkvertise.coins %> coins</strong> are credited to your account instantly</div>
                  </div>
                </div>

              </div>
            </div>

          </div>

        </div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · Powered by <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../../Components/LoadingBar.ejs') %>

  <style>
    /* ── Linkvertise card ── */
    .lv-card {
      background: var(--surface);
      border: 1px solid rgba(37,99,235,0.2);
      border-radius: 16px;
      overflow: hidden;
      position: relative;
    }
    .lv-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: linear-gradient(90deg, #2563eb, #60a5fa, #a78bfa);
      border-radius: 16px 16px 0 0;
    }

    .lv-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 22px 16px;
      border-bottom: 1px solid rgba(37,99,235,0.1);
    }
    .lv-card-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 10px;
      background: rgba(37,99,235,0.14);
      border: 1px solid rgba(37,99,235,0.22);
      display: flex; align-items: center; justify-content: center;
    }
    .lv-card-title { font-size: 14px; font-weight: 700; color: #e2e8f0; }
    .lv-card-sub   { font-size: 11px; color: #3b4f7a; margin-top: 2px; }

    /* reward highlight */
    .lv-reward-wrap {
      text-align: center;
      padding: 30px 24px 20px;
    }
    .lv-reward-num {
      font-size: 42px;
      font-weight: 900;
      color: #93c5fd;
      letter-spacing: -2px;
      line-height: 1;
    }
    .lv-reward-desc {
      font-size: 12px;
      color: #4b5f8a;
      margin-top: 6px;
    }

    /* CTA */
    .lv-cta-wrap {
      padding: 0 22px 24px;
      text-align: center;
    }
    .lv-btn {
      width: 100%;
      padding: 11px !important;
      font-size: 13px !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .lv-cta-hint {
      font-size: 11px;
      color: #4b4669;
      margin-top: 8px;
    }

    /* ── Steps card ── */
    .lv-steps-card {
      background: rgba(37,99,235,0.05);
      border: 1px solid rgba(37,99,235,0.14);
      border-radius: 14px;
      padding: 18px 20px;
    }
    .lv-steps-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.9px;
      color: #7c6faa;
      margin-bottom: 16px;
    }
    .lv-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .lv-step {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }
    .lv-step-num {
      width: 28px; height: 28px; flex-shrink: 0;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 800;
    }
    .lv-step-num--blue   { background: rgba(37,99,235,0.2);  color: #93c5fd; }
    .lv-step-num--purple { background: rgba(124,58,237,0.2); color: #c4b5fd; }
    .lv-step-num--green  { background: rgba(16,185,129,0.2); color: #6ee7b7; }

    .lv-step-head {
      font-size: 13px; font-weight: 600; color: #e2e8f0;
      margin-bottom: 2px;
    }
    .lv-step-desc {
      font-size: 12px; color: #7c6faa; line-height: 1.5;
    }
    .lv-step-desc strong { color: #c4b5fd; font-weight: 600; }

    .lv-step-divider {
      width: 1px;
      height: 16px;
      background: rgba(139,92,246,0.15);
      margin: 4px 0 4px 13px;
    }
  </style>

</body>
</html>