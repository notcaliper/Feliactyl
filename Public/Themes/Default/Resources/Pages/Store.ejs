<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">

        <% if (req.query.err && req.query.err !== 'none') { %>
        <% const _storeErrors = { 'NOTENOUGHCOINS':'Not enough coins.','ALREADYATMAX':'Already at maximum resources.','DISABLED':'Store is currently disabled.' }; %>
        <div class="alert-banner alert-banner--red mb-4"><%= _storeErrors[req.query.err] || ('Error: ' + req.query.err) %></div>
        <% } else if (req.query.err === 'none') { %>
        <div class="alert-banner alert-banner--green mb-4">Purchase successful!</div>
        <% } %>

        <!-- Page header -->
        <div class="page-header">
          <div class="page-title">Store</div>
          <div class="page-subtitle">Spend your coins to upgrade server resources 🛒</div>
        </div>

        <!-- Balance bar -->
        <div class="store-bal-strip">
          <div class="store-bal-left">
            <div class="store-bal-icon">
              <svg width="16" height="16" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <div class="store-bal-label">Your Balance</div>
              <div class="store-bal-val">🪙 <%= Math.floor(coins * 100) / 100 %> coins</div>
            </div>
          </div>
          <div class="store-bal-right">
            <span class="store-bal-plan"><%= packagename.charAt(0).toUpperCase() + packagename.slice(1) %> plan</span>
            <a href="/earn" class="store-earn-btn">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Earn More
            </a>
          </div>
        </div>

        <!-- Section label -->
        <div class="store-section-label">
          <svg width="14" height="14" fill="none" stroke="#6b7280" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          Resource Add-ons
        </div>

        <!-- Store grid -->
        <div class="store-grid">

          <!-- RAM -->
          <div class="store-card store-card--purple">
            <div class="store-card-top">
              <div class="store-card-icon store-card-icon--purple">
                <svg width="18" height="18" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
              </div>
              <div>
                <div class="store-card-title">RAM</div>
                <div class="store-card-sub">Memory boost</div>
              </div>
              <div class="store-card-current store-card-current--purple"><%= extraresources.ram %> MB owned</div>
            </div>
            <div class="store-card-price">
              <span class="store-price-val"><%= settings.api.client.coins.store.ram.cost %></span>
              <span class="store-price-unit">🪙 / <%= settings.api.client.coins.store.ram.per %> MB</span>
            </div>
            <form action="/buyram" method="POST">
              <div class="store-select-wrap">
                <select name="amount" class="store-select">
                  <option value="1"><%= settings.api.client.coins.store.ram.per %> MB — <%= settings.api.client.coins.store.ram.cost %> coins</option>
                  <option value="2"><%= settings.api.client.coins.store.ram.per * 2 %> MB — <%= settings.api.client.coins.store.ram.cost * 2 %> coins</option>
                  <option value="3"><%= settings.api.client.coins.store.ram.per * 3 %> MB — <%= settings.api.client.coins.store.ram.cost * 3 %> coins</option>
                  <option value="4"><%= settings.api.client.coins.store.ram.per * 4 %> MB — <%= settings.api.client.coins.store.ram.cost * 4 %> coins</option>
                </select>
              </div>
              <button type="submit" class="store-btn store-btn--purple">Purchase</button>
            </form>
          </div>

          <!-- Disk -->
          <div class="store-card store-card--blue">
            <div class="store-card-top">
              <div class="store-card-icon store-card-icon--blue">
                <svg width="18" height="18" fill="none" stroke="#93c5fd" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>
              </div>
              <div>
                <div class="store-card-title">Disk</div>
                <div class="store-card-sub">Storage space</div>
              </div>
              <div class="store-card-current store-card-current--blue"><%= extraresources.disk %> MB owned</div>
            </div>
            <div class="store-card-price">
              <span class="store-price-val"><%= settings.api.client.coins.store.disk.cost %></span>
              <span class="store-price-unit">🪙 / <%= settings.api.client.coins.store.disk.per %> MB</span>
            </div>
            <form action="/buydisk" method="POST">
              <div class="store-select-wrap">
                <select name="amount" class="store-select">
                  <option value="1"><%= settings.api.client.coins.store.disk.per %> MB — <%= settings.api.client.coins.store.disk.cost %> coins</option>
                  <option value="2"><%= settings.api.client.coins.store.disk.per * 2 %> MB — <%= settings.api.client.coins.store.disk.cost * 2 %> coins</option>
                  <option value="3"><%= settings.api.client.coins.store.disk.per * 3 %> MB — <%= settings.api.client.coins.store.disk.cost * 3 %> coins</option>
                  <option value="4"><%= settings.api.client.coins.store.disk.per * 4 %> MB — <%= settings.api.client.coins.store.disk.cost * 4 %> coins</option>
                  <option value="5"><%= settings.api.client.coins.store.disk.per * 5 %> MB — <%= settings.api.client.coins.store.disk.cost * 5 %> coins</option>
                </select>
              </div>
              <button type="submit" class="store-btn store-btn--blue">Purchase</button>
            </form>
          </div>

          <!-- CPU -->
          <div class="store-card store-card--green">
            <div class="store-card-top">
              <div class="store-card-icon store-card-icon--green">
                <svg width="18" height="18" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <div>
                <div class="store-card-title">CPU</div>
                <div class="store-card-sub">Processing power</div>
              </div>
              <div class="store-card-current store-card-current--green"><%= extraresources.cpu %>% owned</div>
            </div>
            <div class="store-card-price">
              <span class="store-price-val"><%= settings.api.client.coins.store.cpu.cost %></span>
              <span class="store-price-unit">🪙 / <%= settings.api.client.coins.store.cpu.per %>%</span>
            </div>
            <form action="/buycpu" method="POST">
              <div class="store-select-wrap">
                <select name="amount" class="store-select">
                  <option value="1"><%= settings.api.client.coins.store.cpu.per %>% — <%= settings.api.client.coins.store.cpu.cost %> coins</option>
                  <option value="2"><%= settings.api.client.coins.store.cpu.per * 2 %>% — <%= settings.api.client.coins.store.cpu.cost * 2 %> coins</option>
                </select>
              </div>
              <button type="submit" class="store-btn store-btn--green">Purchase</button>
            </form>
          </div>

          <!-- Servers -->
          <div class="store-card store-card--amber">
            <div class="store-card-top">
              <div class="store-card-icon store-card-icon--amber">
                <svg width="18" height="18" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
              </div>
              <div>
                <div class="store-card-title">Servers</div>
                <div class="store-card-sub">Server slots</div>
              </div>
              <div class="store-card-current store-card-current--amber"><%= extraresources.servers %> owned</div>
            </div>
            <div class="store-card-price">
              <span class="store-price-val"><%= settings.api.client.coins.store.servers.cost %></span>
              <span class="store-price-unit">🪙 / <%= settings.api.client.coins.store.servers.per %> slot</span>
            </div>
            <form action="/buyservers" method="POST">
              <div class="store-select-wrap">
                <select name="amount" class="store-select">
                  <option value="1"><%= settings.api.client.coins.store.servers.per %> slot — <%= settings.api.client.coins.store.servers.cost %> coins</option>
                  <option value="2"><%= settings.api.client.coins.store.servers.per * 2 %> slots — <%= settings.api.client.coins.store.servers.cost * 2 %> coins</option>
                  <option value="3"><%= settings.api.client.coins.store.servers.per * 3 %> slots — <%= settings.api.client.coins.store.servers.cost * 3 %> coins</option>
                  <option value="4"><%= settings.api.client.coins.store.servers.per * 4 %> slots — <%= settings.api.client.coins.store.servers.cost * 4 %> coins</option>
                </select>
              </div>
              <button type="submit" class="store-btn store-btn--amber">Purchase</button>
            </form>
          </div>

        </div>

        <!-- Plans section -->
        <div class="store-section-label" style="margin-top:28px;">
          <svg width="14" height="14" fill="none" stroke="#6b7280" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Upgrade Plan
        </div>

        <% const _planErrors = { 'NOTENOUGHCOINS': 'Not enough coins.', 'ALREADYONPLAN': 'You are already on this plan.', 'INVALIDPLAN': 'Invalid plan.', 'MISSINGPLAN': 'No plan selected.' }; %>
        <% if (_planErrors[req.query.err]) { %>
        <div class="alert-banner alert-banner--red mb-4"><%= _planErrors[req.query.err] %></div>
        <% } %>

        <div class="plans-grid">
          <% const _planKeys = Object.keys(settings.api.client.packages.list); %>
          <% for (let _pi = 0; _pi < _planKeys.length; _pi++) { %>
          <% const _pname = _planKeys[_pi]; %>
          <% const _plan = settings.api.client.packages.list[_pname]; %>
          <% const _isCurrent = (packagename === _pname); %>
            <div class="plan-card <%= _isCurrent ? 'plan-card--active' : '' %>">
              <div class="plan-card-header">
                <div class="plan-name"><%= _pname.replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()) %></div>
                <% if (_isCurrent) { %><span class="plan-badge-current">✓ Current</span><% } %>
              </div>
              <div class="plan-specs">
                <div class="plan-spec">
                  <span class="plan-spec-label">
                    <svg width="11" height="11" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                    RAM
                  </span>
                  <span class="plan-spec-val"><%= _plan.ram %> MB</span>
                </div>
                <div class="plan-spec">
                  <span class="plan-spec-label">
                    <svg width="11" height="11" fill="none" stroke="#93c5fd" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/></svg>
                    Disk
                  </span>
                  <span class="plan-spec-val"><%= _plan.disk %> MB</span>
                </div>
                <div class="plan-spec">
                  <span class="plan-spec-label">
                    <svg width="11" height="11" fill="none" stroke="#6ee7b7" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    CPU
                  </span>
                  <span class="plan-spec-val"><%= _plan.cpu %>%</span>
                </div>
                <div class="plan-spec">
                  <span class="plan-spec-label">
                    <svg width="11" height="11" fill="none" stroke="#fcd34d" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                    Servers
                  </span>
                  <span class="plan-spec-val"><%= _plan.servers %></span>
                </div>
              </div>
              <% const _disc = settings.api.client.packages.discounts && settings.api.client.packages.discounts[_pname]; %>
              <% const _discActive = _disc && (!_disc.expiresAt || _disc.expiresAt > Date.now()); %>
              <% const _baseCost = _plan.cost || 0; %>
              <% const _saleCost = _discActive ? Math.round(_baseCost * (1 - _disc.pct / 100)) : _baseCost; %>
              <div class="plan-cost">
                <% if (_discActive) { %>
                  <span class="plan-cost-orig">🪙 <%= _baseCost.toLocaleString() %></span>
                  <span>🪙 <%= _saleCost.toLocaleString() %></span>
                  <span class="plan-discount-badge">-<%= _disc.pct %>%</span>
                <% } else { %>
                  🪙 <%= _baseCost.toLocaleString() %> <span class="plan-cost-unit">coins</span>
                <% } %>
              </div>
              <form action="/buyplan" method="POST">
                <input type="hidden" name="plan" value="<%= _pname %>">
                <button type="submit" class="plan-btn" <%= _isCurrent ? 'disabled' : '' %>>
                  <%= _isCurrent ? '✓ Current Plan' : (_saleCost === 0 ? 'Switch Free' : 'Purchase Plan') %>
                </button>
              </form>
            </div>
          <% } %>
        </div>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · Powered by <a href="https://github.com/notcaliper/Feliactyl" target="_blank" style="color:#a78bfa;">Feliactyl v<%= settings.version %></a></div>
            <div class="col-6 text-end"><a href="https://discord.gg/N7C2nbYpQf" target="_blank" style="color:#5865f2;text-decoration:none;">Discord</a> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../../Components/LoadingBar.ejs') %>

  <style>
    /* ── Balance strip ── */
    .store-bal-strip {
      display:flex; align-items:center; justify-content:space-between;
      background:var(--surface); border:1px solid var(--border);
      border-radius:14px; padding:16px 22px; margin-bottom:20px; flex-wrap:wrap; gap:12px;
    }
    .store-bal-left  { display:flex; align-items:center; gap:14px; }
    .store-bal-right { display:flex; align-items:center; gap:12px; }
    .store-bal-icon  { width:38px; height:38px; border-radius:10px; background:rgba(245,158,11,.12); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .store-bal-label { font-size:11px; color:#6b7280; text-transform:uppercase; letter-spacing:.7px; font-weight:600; }
    .store-bal-val   { font-size:17px; font-weight:800; color:#fcd34d; margin-top:2px; }
    .store-bal-plan  {
      font-size:11px; font-weight:600; padding:4px 12px; border-radius:20px;
      background:rgba(124,58,237,.12); color:#c4b5fd; border:1px solid rgba(124,58,237,.2);
    }
    .store-earn-btn {
      display:inline-flex; align-items:center; gap:6px; padding:8px 14px;
      border-radius:9px; font-size:12px; font-weight:600;
      background:rgba(16,185,129,.1); color:#6ee7b7;
      border:1px solid rgba(16,185,129,.2); text-decoration:none; transition:all .15s;
    }
    .store-earn-btn:hover { background:rgba(16,185,129,.2); color:#6ee7b7; text-decoration:none; }

    /* ── Section label ── */
    .store-section-label {
      display:flex; align-items:center; gap:8px;
      font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#4b5563;
      margin-bottom:14px;
    }

    /* ── Store grid ── */
    .store-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
    @media(max-width:1024px){ .store-grid{ grid-template-columns:repeat(2,1fr); } }
    @media(max-width:560px) { .store-grid{ grid-template-columns:1fr; } }

    /* ── Store card ── */
    .store-card {
      background: var(--surface);
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(139,92,246,0.14);
      transition: transform 0.2s, box-shadow 0.2s;
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    .store-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    }
    .store-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      border-radius: 16px 16px 0 0;
    }
    .store-card--purple::before { background: linear-gradient(90deg,#7c3aed,#a78bfa); }
    .store-card--blue::before   { background: linear-gradient(90deg,#2563eb,#60a5fa); }
    .store-card--green::before  { background: linear-gradient(90deg,#059669,#6ee7b7); }
    .store-card--amber::before  { background: linear-gradient(90deg,#d97706,#fcd34d); }

    /* hover border accent */
    .store-card--purple:hover { border-color: rgba(124,58,237,0.4); box-shadow: 0 12px 40px rgba(124,58,237,0.15); }
    .store-card--blue:hover   { border-color: rgba(37,99,235,0.4);  box-shadow: 0 12px 40px rgba(37,99,235,0.15); }
    .store-card--green:hover  { border-color: rgba(16,185,129,0.4); box-shadow: 0 12px 40px rgba(16,185,129,0.15); }
    .store-card--amber:hover  { border-color: rgba(217,119,6,0.4);  box-shadow: 0 12px 40px rgba(217,119,6,0.15); }

    .store-card-current {
      margin-left:auto; font-size:10px; font-weight:600; padding:3px 9px;
      border-radius:20px; white-space:nowrap; flex-shrink:0;
    }
    .store-card-current--purple { background:rgba(124,58,237,.12); color:#c4b5fd; }
    .store-card-current--blue   { background:rgba(59,130,246,.12);  color:#93c5fd; }
    .store-card-current--green  { background:rgba(16,185,129,.12);  color:#6ee7b7; }
    .store-card-current--amber  { background:rgba(245,158,11,.12);  color:#fcd34d; }

    .store-card-top {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 20px 16px;
      border-bottom: 1px solid rgba(139,92,246,0.08);
    }
    .store-card-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .store-card-icon--purple { background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.22); }
    .store-card-icon--blue   { background: rgba(37,99,235,0.15);  border: 1px solid rgba(37,99,235,0.22); }
    .store-card-icon--green  { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.22); }
    .store-card-icon--amber  { background: rgba(217,119,6,0.15);  border: 1px solid rgba(217,119,6,0.22); }

    .store-card-title { font-size: 14px; font-weight: 700; color: #e2e8f0; }
    .store-card-sub   { font-size: 11px; color: #6b5f8a; margin-top: 2px; }

    .store-card-price {
      padding: 18px 20px 10px;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .store-price-val  { font-size: 28px; font-weight: 900; color: #e2e8f0; letter-spacing: -1px; line-height: 1; }
    .store-price-unit { font-size: 12px; color: #6b5f8a; }

    .store-select-wrap { padding: 0 20px 12px; }
    .store-select {
      width:100%; padding:9px 12px;
      background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08);
      border-radius:10px; color:#e5e7eb; font-size:13px; outline:none;
      transition:border-color .15s; font-family:inherit; cursor:pointer;
    }
    .store-select:focus { border-color:rgba(124,58,237,.5); }
    .store-select option { background:#1e1b2e; }

    .store-btn {
      display:flex; align-items:center; justify-content:center; gap:6px;
      margin:0 20px 20px; width:calc(100% - 40px);
      padding:10px; border-radius:10px; font-size:13px; font-weight:700;
      border:none; cursor:pointer; font-family:inherit; transition:all .15s; margin-top:auto;
    }
    .store-btn--purple { background:linear-gradient(135deg,#7c3aed,#a78bfa); color:#fff; box-shadow:0 2px 12px rgba(124,58,237,.3); }
    .store-btn--blue   { background:linear-gradient(135deg,#2563eb,#60a5fa); color:#fff; box-shadow:0 2px 12px rgba(37,99,235,.3); }
    .store-btn--green  { background:linear-gradient(135deg,#059669,#34d399); color:#fff; box-shadow:0 2px 12px rgba(16,185,129,.3); }
    .store-btn--amber  { background:linear-gradient(135deg,#d97706,#fcd34d); color:#1a1000; box-shadow:0 2px 12px rgba(217,119,6,.3); }
    .store-btn:hover   { transform:translateY(-1px); filter:brightness(1.1); }

    /* ── Plans grid ── */
    .plans-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }

    /* ── Plan cards ── */
    .plan-card {
      background:var(--surface); border:1px solid rgba(139,92,246,.14);
      border-radius:16px; overflow:hidden; display:flex; flex-direction:column;
      transition:transform .2s, box-shadow .2s, border-color .2s;
    }
    .plan-card:hover { transform:translateY(-3px); box-shadow:0 12px 40px rgba(124,58,237,.12); border-color:rgba(124,58,237,.35); }
    .plan-card--active { border-color:rgba(124,58,237,.5); box-shadow:0 0 0 2px rgba(124,58,237,.2); }
    .plan-card--active .plan-card-header { background:rgba(124,58,237,.1); }
    .plan-card-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:16px 18px 14px; border-bottom:1px solid rgba(139,92,246,.08);
      background:rgba(124,58,237,.04);
    }
    .plan-name { font-size:14px; font-weight:700; color:#e2e8f0; }
    .plan-badge-current { font-size:10px; background:rgba(124,58,237,.25); color:#c4b5fd; border-radius:999px; padding:2px 10px; font-weight:700; border:1px solid rgba(124,58,237,.3); }
    .plan-specs { padding:14px 18px; display:flex; flex-direction:column; gap:9px; flex:1; }
    .plan-spec { display:flex; justify-content:space-between; align-items:center; }
