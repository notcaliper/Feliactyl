<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">

        <!-- Page header -->
        <div class="page-header">
          <div class="page-title">Join for Rewards</div>
          <div class="page-subtitle">Join Discord servers below and earn coins 🪙</div>
        </div>

        <% if (req.query.err === 'claimed') { %>
        <div class="alert-banner alert-banner--green mb-4">✓ Reward claimed! Coins have been added to your account.</div>
        <% } else if (req.query.err) { %>
        <div class="alert-banner alert-banner--red mb-4">Error: <%= req.query.err %></div>
        <% } %>

        <!-- How it works steps -->
        <div class="j4r-how">
          <div class="j4r-how-step">
            <div class="j4r-how-num j4r-how-num--purple">1</div>
            <div class="j4r-how-line"></div>
            <div class="j4r-how-body">
              <div class="j4r-how-title">Find a Server</div>
              <div class="j4r-how-sub">Browse the list below and pick a community to join</div>
            </div>
          </div>
          <div class="j4r-how-connector"></div>
          <div class="j4r-how-step">
            <div class="j4r-how-num j4r-how-num--blue">2</div>
            <div class="j4r-how-line"></div>
            <div class="j4r-how-body">
              <div class="j4r-how-title">Join the Server</div>
              <div class="j4r-how-sub">Click <strong>Join Server</strong> and accept the invite in Discord</div>
            </div>
          </div>
          <div class="j4r-how-connector"></div>
          <div class="j4r-how-step">
            <div class="j4r-how-num j4r-how-num--green">3</div>
            <div class="j4r-how-line"></div>
            <div class="j4r-how-body">
              <div class="j4r-how-title">Claim Reward</div>
              <div class="j4r-how-sub">Come back and click <strong>Claim Reward</strong> — coins are added instantly</div>
            </div>
          </div>
        </div>

        <!-- Server list header -->
        <div class="j4r-list-header">
          <div class="j4r-list-title">
            <svg width="14" height="14" fill="none" stroke="#a78bfa" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Available Servers
            <span class="j4r-count-badge"><%= settings.api.client.j4r.ads.length %></span>
          </div>
        </div>

        <!-- Server cards -->
        <% if (settings.api.client.j4r.ads.length === 0) { %>
          <div class="j4r-empty">
            <div class="j4r-empty-icon">
              <svg width="32" height="32" fill="none" stroke="#4b5563" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            </div>
            <div class="j4r-empty-title">No servers yet</div>
            <div class="j4r-empty-sub">J4R servers haven't been configured by an admin yet. Check back later!</div>
          </div>
        <% } else { %>
          <div class="j4r-list">
            <% for (let i = 0, len = settings.api.client.j4r.ads.length; i < len; i++) { %>
              <div class="j4r-row">

                <!-- Avatar -->
                <div class="j4r-avatar">
                  <svg width="20" height="20" fill="none" stroke="#a78bfa" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
                </div>

                <!-- Info -->
                <div class="j4r-info">
                  <div class="j4r-name"><%= settings.api.client.j4r.ads[i].name %></div>
                  <div class="j4r-desc">Discord community · Join to earn coins</div>
                </div>

                <!-- Reward -->
                <div class="j4r-reward">
                  <span class="j4r-coin-icon">🪙</span>
                  <span class="j4r-coin-val"><%= settings.api.client.j4r.ads[i].coins %></span>
                  <span class="j4r-coin-label">coins</span>
                </div>

                <!-- Actions -->
                <div class="j4r-actions">
                  <a href="<%= settings.api.client.j4r.ads[i].invite %>" target="_blank" rel="noopener" class="j4r-btn-join">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Join Server
                  </a>
                  <a href="/login?prompt=none&redirect=j4r" class="j4r-btn-claim">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Claim Reward
                  </a>
                </div>

              </div>
            <% } %>
          </div>
        <% } %>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · Powered by <a href="https://github.com/notcaliper/Feliactyl" target="_blank" style="color:#a78bfa;">Feliactyl v<%= settings.version %></a></div>
            <div class="col-6 text-end"><a href="https://discord.gg/N7C2nbYpQf" target="_blank" style="color:#5865f2;text-decoration:none;">Discord</a> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../../Components/LoadingBar.ejs') %>

  <style>
    /* ── How it works strip ── */
    .j4r-how {
      display: flex; align-items: center;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; padding: 20px 24px; margin-bottom: 20px;
      gap: 0; flex-wrap: wrap; row-gap: 16px;
    }
    .j4r-how-step { display:flex; align-items:center; gap:14px; flex:1; min-width:180px; }
    .j4r-how-num {
      width:32px; height:32px; flex-shrink:0; border-radius:50%;
      display:flex; align-items:center; justify-content:center;
      font-size:13px; font-weight:800;
    }
    .j4r-how-num--purple { background:rgba(124,58,237,.18); color:#c4b5fd; }
    .j4r-how-num--blue   { background:rgba(59,130,246,.18);  color:#93c5fd; }
    .j4r-how-num--green  { background:rgba(16,185,129,.18);  color:#6ee7b7; }
    .j4r-how-body { min-width:0; }
    .j4r-how-title { font-size:13px; font-weight:700; color:#e2e8f0; }
    .j4r-how-sub   { font-size:11px; color:#4b5563; margin-top:2px; line-height:1.45; }
    .j4r-how-sub strong { color:#a78bfa; font-weight:600; }
    .j4r-how-connector {
      width:32px; flex-shrink:0; height:1px;
      background:linear-gradient(90deg,rgba(124,58,237,.3),rgba(59,130,246,.3));
      margin:0 8px;
    }
    @media(max-width:640px){ .j4r-how-connector{ display:none; } }

    /* ── List header ── */
    .j4r-list-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .j4r-list-title {
      display:flex; align-items:center; gap:8px;
      font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#4b5563;
    }
    .j4r-count-badge {
      display:inline-flex; align-items:center; justify-content:center;
      min-width:20px; height:20px; padding:0 6px; border-radius:10px;
      background:rgba(124,58,237,.15); color:#a78bfa; font-size:11px; font-weight:700;
    }

    /* ── Server list ── */
    .j4r-list { display:flex; flex-direction:column; gap:10px; }

    /* ── Server row ── */
    .j4r-row {
      display:flex; align-items:center; gap:16px;
      background:var(--surface); border:1px solid rgba(139,92,246,.12);
      border-radius:14px; padding:16px 20px;
      transition:border-color .18s, box-shadow .18s, transform .18s;
    }
    .j4r-row:hover {
      border-color:rgba(124,58,237,.4);
      box-shadow:0 6px 28px rgba(124,58,237,.12);
      transform:translateY(-1px);
    }

    /* avatar */
    .j4r-avatar {
      width:44px; height:44px; flex-shrink:0; border-radius:12px;
      background:rgba(124,58,237,.12); border:1px solid rgba(124,58,237,.2);
      display:flex; align-items:center; justify-content:center;
    }

    /* info */
    .j4r-info { flex:1; min-width:0; }
    .j4r-name  { font-size:14px; font-weight:600; color:#e2e8f0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .j4r-desc  { font-size:11px; color:#4b5563; margin-top:2px; }

    /* reward pill */
    .j4r-reward {
      display:flex; align-items:baseline; gap:4px;
      background:rgba(124,58,237,.1); border:1px solid rgba(124,58,237,.18);
      border-radius:999px; padding:5px 14px; white-space:nowrap; flex-shrink:0;
    }
    .j4r-coin-icon  { font-size:13px; }
    .j4r-coin-val   { font-size:15px; font-weight:800; color:#c4b5fd; letter-spacing:-.5px; }
    .j4r-coin-label { font-size:11px; color:#7c6faa; }

    /* action buttons */
    .j4r-actions { display:flex; gap:8px; flex-shrink:0; }
    .j4r-btn-join {
      display:inline-flex; align-items:center; gap:6px;
      padding:8px 14px; border-radius:9px; font-size:12px; font-weight:600;
      background:linear-gradient(135deg,#4f46e5,#7c3aed); color:#fff; text-decoration:none;
      border:none; transition:all .15s; box-shadow:0 2px 10px rgba(79,70,229,.25);
    }
    .j4r-btn-join:hover  { transform:translateY(-1px); box-shadow:0 4px 16px rgba(79,70,229,.4); color:#fff; text-decoration:none; }
    .j4r-btn-claim {
      display:inline-flex; align-items:center; gap:6px;
      padding:8px 14px; border-radius:9px; font-size:12px; font-weight:600;
      background:rgba(16,185,129,.1); color:#6ee7b7;
      border:1px solid rgba(16,185,129,.22); text-decoration:none; transition:all .15s;
    }
    .j4r-btn-claim:hover { background:rgba(16,185,129,.2); color:#6ee7b7; text-decoration:none; }

    /* ── Empty state ── */
    .j4r-empty {
      background:var(--surface); border:1px solid var(--border);
      border-radius:14px; padding:56px 24px; text-align:center;
    }
    .j4r-empty-icon {
      width:64px; height:64px; border-radius:18px; margin:0 auto 18px;
      background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.07);
      display:flex; align-items:center; justify-content:center;
    }
    .j4r-empty-title { font-size:16px; font-weight:700; color:#6b7280; margin-bottom:6px; }
    .j4r-empty-sub   { font-size:13px; color:#374151; max-width:320px; margin:0 auto; line-height:1.6; }

    @media(max-width:640px){
      .j4r-row { flex-wrap:wrap; }
      .j4r-reward { order:3; }
      .j4r-actions { order:4; width:100%; }
      .j4r-btn-join, .j4r-btn-claim { flex:1; justify-content:center; }
    }
  </style>

</body>
</html>