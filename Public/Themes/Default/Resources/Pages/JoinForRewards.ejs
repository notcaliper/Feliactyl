<!DOCTYPE html>
<html lang="en">
<%- include('../../Components/Header.ejs') %>
<%- include('../../Components/Styles.ejs') %>

<body>
  <div class="wrapper">
    <%- include('../../Routers/Navigation.ejs') %>
    <div class="main">
      <%- include('../../Components/Topbar.ejs') %>

      <main class="content">

        <!-- Page header -->
        <div class="page-header">
          <div class="page-title">Join for Rewards</div>
          <div class="page-subtitle">Join Discord servers below and earn coins 🪙</div>
        </div>

        <% if (req.query.err === 'claimed') { %>
        <div class="alert-banner alert-banner--green mb-4">✓ Reward claimed! Coins have been added to your account.</div>
        <% } else if (req.query.err) { %>
        <div class="alert-banner alert-banner--red mb-4">Error: <%= req.query.err %></div>
        <% } %>

        <!-- Info banner -->
        <div class="j4r-banner">
          <div class="j4r-banner-icon">
            <svg width="20" height="20" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <div class="j4r-banner-title">How it works</div>
            <div class="j4r-banner-sub">Click <strong>Join Server</strong>, then come back and hit <strong>Claim Reward</strong> to receive your coins.</div>
          </div>
        </div>

        <!-- Server cards -->
        <% if (settings.api.client.j4r.ads.length === 0) { %>
          <div class="card" style="text-align:center;padding:48px 24px;color:#6b7280;">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin:0 auto 12px;display:block;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            No J4R servers configured yet.
          </div>
        <% } else { %>
          <div class="j4r-list">
            <% for (let i = 0, len = settings.api.client.j4r.ads.length; i < len; i++) { %>
              <div class="j4r-row">

                <!-- Left: avatar + name -->
                <div class="j4r-info">
                  <div class="j4r-avatar">
                    <svg width="18" height="18" fill="none" stroke="#a78bfa" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  </div>
                  <div>
                    <div class="j4r-name"><%= settings.api.client.j4r.ads[i].name %></div>
                    <div class="j4r-desc">Discord community server</div>
                  </div>
                </div>

                <!-- Middle: reward pill -->
                <div class="j4r-reward">
                  <span class="j4r-coin-icon">🪙</span>
                  <span class="j4r-coin-val"><%= settings.api.client.j4r.ads[i].coins %></span>
                  <span class="j4r-coin-label">coins</span>
                </div>

                <!-- Right: actions -->
                <div class="j4r-actions">
                  <a href="<%= settings.api.client.j4r.ads[i].invite %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm j4r-btn-join">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Join Server
                  </a>
                  <a href="/login?prompt=none&redirect=j4r" class="btn btn-secondary btn-sm j4r-btn-claim">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;vertical-align:-2px;"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Claim Reward
                  </a>
                </div>

              </div>
            <% } %>
          </div>
        <% } %>

      </main>

      <footer class="footer">
        <div class="container-fluid">
          <div class="row">
            <div class="col-6">© <%= settings.name %> · Powered by <a href="https://github.com/notcaliper/feliactyl" target="_blank">Feliactyl</a></div>
            <div class="col-6 text-end"><code>v<%= settings.version %></code> · <span id="loadtime"></span></div>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../../Components/LoadingBar.ejs') %>

  <style>
    /* ── J4R banner ── */
    .j4r-banner {
      display: flex;
      align-items: center;
      gap: 14px;
      background: rgba(124,58,237,0.08);
      border: 1px solid rgba(124,58,237,0.22);
      border-radius: 12px;
      padding: 14px 18px;
      margin-bottom: 24px;
    }
    .j4r-banner-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 10px;
      background: rgba(124,58,237,0.18);
      display: flex; align-items: center; justify-content: center;
    }
    .j4r-banner-title {
      font-size: 13px; font-weight: 700; color: #c4b5fd;
      margin-bottom: 2px;
    }
    .j4r-banner-sub {
      font-size: 12px; color: #7c6faa;
    }
    .j4r-banner-sub strong { color: #a78bfa; font-weight: 600; }

    /* ── J4R list ── */
    .j4r-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* ── J4R row ── */
    .j4r-row {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--surface);
      border: 1px solid rgba(139,92,246,0.14);
      border-radius: 14px;
      padding: 16px 20px;
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    .j4r-row:hover {
      border-color: rgba(124,58,237,0.4);
      box-shadow: 0 6px 28px rgba(124,58,237,0.12);
      transform: translateY(-1px);
    }

    /* avatar */
    .j4r-avatar {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 12px;
      background: rgba(124,58,237,0.15);
      display: flex; align-items: center; justify-content: center;
    }

    /* info */
    .j4r-info {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
    }
    .j4r-name {
      font-size: 14px; font-weight: 600; color: #e2e8f0;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .j4r-desc {
      font-size: 11px; color: #4b4669;
      margin-top: 2px;
    }

    /* reward */
    .j4r-reward {
      display: flex;
      align-items: baseline;
      gap: 4px;
      background: rgba(124,58,237,0.12);
      border: 1px solid rgba(124,58,237,0.2);
      border-radius: 999px;
      padding: 5px 14px;
      white-space: nowrap;
    }
    .j4r-coin-icon { font-size: 13px; }
    .j4r-coin-val  { font-size: 15px; font-weight: 800; color: #c4b5fd; letter-spacing: -0.5px; }
    .j4r-coin-label{ font-size: 11px; color: #7c6faa; }

    /* actions */
    .j4r-actions {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }
    .j4r-btn-join {
      font-size: 12px !important;
      padding: 7px 14px !important;
      display: inline-flex; align-items: center;
    }
    .j4r-btn-claim {
      font-size: 12px !important;
      padding: 7px 14px !important;
      display: inline-flex; align-items: center;
    }

    @media (max-width: 640px) {
      .j4r-row { flex-wrap: wrap; }
      .j4r-reward { order: 3; }
      .j4r-actions { order: 4; width: 100%; }
      .j4r-btn-join, .j4r-btn-claim { flex: 1; justify-content: center; }
    }
  </style>

</body>
</html>