<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Inter', sans-serif;
    background: #0a0a0f;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  body::before {
    content: '';
    position: fixed;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 70%);
    top: -200px; left: -200px;
    animation: orb1 8s ease-in-out infinite alternate;
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
    bottom: -150px; right: -150px;
    animation: orb2 10s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes orb1 { from { transform: translate(0,0) scale(1); } to { transform: translate(80px,60px) scale(1.2); } }
  @keyframes orb2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-60px,-80px) scale(1.15); } }
  .grid-bg {
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }
  .login-wrapper {
    position: relative; z-index: 10;
    width: 100%; max-width: 440px; padding: 20px;
  }
  .login-header { text-align: center; margin-bottom: 32px; }
  .login-logo {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #7c3aed, #3b82f6);
    border-radius: 20px;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    animation: pulse-glow 3s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 30px rgba(124,58,237,0.4); }
    50%       { box-shadow: 0 0 60px rgba(124,58,237,0.7); }
  }
  .login-title { font-size: 28px; font-weight: 700; color: white; letter-spacing: -0.5px; margin-bottom: 8px; }
  .login-subtitle { font-size: 14px; color: #6b7280; }
  .glass-card {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px; padding: 36px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.5);
  }
  .provider-label {
    font-size: 12px; font-weight: 500; color: #6b7280;
    text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 16px; text-align: center;
  }
  .btn-discord {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    width: 100%; padding: 16px 24px;
    background: #5865F2;
    color: white; font-family: 'Inter', sans-serif;
    font-size: 15px; font-weight: 600;
    border: none; border-radius: 12px; cursor: pointer;
    text-decoration: none; transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(88,101,242,0.4);
  }
  .btn-discord:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(88,101,242,0.6);
    color: white; text-decoration: none;
    background: #4752c4;
  }
  .back-link {
    display: block; text-align: center; margin-top: 20px;
    font-size: 13px; color: #4b5563; text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: #9ca3af; }
  .version-badge {
    position: fixed; bottom: 20px; right: 20px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: #4b5563; font-size: 11px; padding: 6px 12px;
    border-radius: 20px; font-family: 'Inter', sans-serif;
  }
</style>

<body>
  <div class="grid-bg"></div>

  <div class="login-wrapper">
    <div class="login-header">
      <div class="login-logo">
        <img src="../assets/default/img/logo-icon.svg" alt="<%= settings.name %>" width="40" height="40">
      </div>
      <div class="login-title">Choose a provider</div>
      <div class="login-subtitle">Select how you'd like to sign in</div>
    </div>

    <div class="glass-card">
      <p class="provider-label">Available providers</p>

      <a href="../login" class="btn-discord">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 127.14 96.36" fill="white"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
        Continue with Discord
      </a>

      <a href="../" class="back-link">← Back to home</a>
    </div>
  </div>

  <div class="version-badge"><%= settings.name %> v<%= settings.version %></div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../Components/LoadingBar.ejs') %>
</body>
</html>