<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', sans-serif;
    background: #0a0a0f;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  body::before {
    content: '';
    position: fixed;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(139,92,246,0.12) 0%, transparent 70%);
    top: -200px; left: -200px;
    animation: orb1 8s ease-in-out infinite alternate;
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 70%);
    bottom: -150px; right: -150px;
    animation: orb2 10s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes orb1 { from { transform: translate(0,0) scale(1); } to { transform: translate(80px,60px) scale(1.2); } }
  @keyframes orb2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-60px,-80px) scale(1.15); } }

  .grid-bg {
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }

  /* Reset Bootstrap interference */
  html, body { width: 100% !important; height: 100% !important; }
  body { display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; }
  main, .container, .row, .col-sm-10, .d-table, .d-table-cell { all: unset !important; }

  .lo-wrap {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 420px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lo-icon {
    width: 76px; height: 76px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    animation: lo-float 4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes lo-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  .lo-title {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
    text-align: center;
    display: block;
    width: 100%;
  }
  .lo-sub {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 32px;
    line-height: 1.6;
    text-align: center;
    display: block;
    width: 100%;
  }

  .lo-card {
    width: 100%;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .lo-btn-discord {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: linear-gradient(135deg, #7c3aed, #3b82f6) !important;
    color: #ffffff !important;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: none !important;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none !important;
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(124,58,237,0.35);
    margin-bottom: 10px;
  }
  .lo-btn-discord:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(124,58,237,0.5);
    color: #ffffff !important;
  }

  .lo-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 14px;
    color: #374151;
    font-size: 12px;
    font-family: 'Inter', sans-serif;
  }
  .lo-divider::before, .lo-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.07);
  }

  .lo-btn-panel {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: rgba(255,255,255,0.05) !important;
    color: #9ca3af !important;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .lo-btn-panel:hover {
    background: rgba(255,255,255,0.09) !important;
    color: #ffffff !important;
    border-color: rgba(255,255,255,0.2) !important;
  }

  .lo-badge {
    position: fixed;
    bottom: 20px; right: 20px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: #4b5563;
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 20px;
    font-family: 'Inter', sans-serif;
  }
</style>

<body>
  <div class="grid-bg"></div>

  <div class="lo-wrap">
    <div class="lo-icon">
      <svg width="34" height="34" fill="none" stroke="#6b7280" stroke-width="1.5" viewBox="0 0 24 24">
        <path d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15"/>
        <path d="M18 15l3-3m0 0-3-3m3 3H9"/>
      </svg>
    </div>

    <span class="lo-title">You've been signed out</span>
    <span class="lo-sub">Your session has ended. Sign back in to access your <strong style="color:#c4b5fd;"><%= settings.name %></strong> dashboard.</span>

    <div class="lo-card">
      <a href="/auth" class="lo-btn-discord">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 127.14 96.36" fill="white"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
        Sign in with Discord
      </a>
      <div class="lo-divider">or</div>
      <a href="/panel" class="lo-btn-panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/></svg>
        Open Pterodactyl Panel
      </a>
    </div>
  </div>

  <div class="lo-badge"><%= settings.name %> v<%= settings.version %></div>

  <%- include('../Components/LoadingBar.ejs') %>
</body>
</html>