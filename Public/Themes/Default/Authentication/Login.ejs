<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', sans-serif;
    background: #0a0a0f;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  /* Animated gradient orbs */
  body::before {
    content: '';
    position: fixed;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 70%);
    top: -200px; left: -200px;
    animation: orb1 8s ease-in-out infinite alternate;
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
    bottom: -150px; right: -150px;
    animation: orb2 10s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes orb1 { from { transform: translate(0,0) scale(1); } to { transform: translate(80px,60px) scale(1.2); } }
  @keyframes orb2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-60px,-80px) scale(1.15); } }

  /* Grid lines overlay */
  .grid-bg {
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }

  .login-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 440px;
    padding: 20px;
  }

  /* Logo + title */
  .login-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .login-logo {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #7c3aed, #3b82f6);
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 0 40px rgba(124,58,237,0.4);
    animation: pulse-glow 3s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 30px rgba(124,58,237,0.4); }
    50%       { box-shadow: 0 0 60px rgba(124,58,237,0.7); }
  }
  .login-title {
    font-size: 28px;
    font-weight: 700;
    color: white;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  .login-subtitle {
    font-size: 14px;
    color: #6b7280;
    font-weight: 400;
  }

  /* Glass card */
  .glass-card {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.5);
  }

  /* Buttons */
  .btn-login {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: linear-gradient(135deg, #7c3aed, #3b82f6);
    color: white;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(124,58,237,0.35);
    margin-bottom: 12px;
  }
  .btn-login:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(124,58,237,0.5);
    color: white;
    text-decoration: none;
  }
  .btn-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: rgba(255,255,255,0.05);
    color: #9ca3af;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-panel:hover {
    background: rgba(255,255,255,0.09);
    color: white;
    text-decoration: none;
    border-color: rgba(255,255,255,0.2);
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 16px 0;
    color: #374151;
    font-size: 12px;
  }
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.07);
  }

  .terms {
    text-align: center;
    font-size: 12px;
    color: #4b5563;
    margin-top: 20px;
    line-height: 1.6;
  }
  .terms a { color: #7c3aed; text-decoration: none; }
  .terms a:hover { text-decoration: underline; }

  /* Version badge */
  .version-badge {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: #4b5563;
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 20px;
    font-family: 'Inter', sans-serif;
  }
</style>

<body>
  <div class="grid-bg"></div>

  <div class="login-wrapper">
    <div class="login-header">
      <div class="login-logo">
        <img src="../assets/default/img/logo-icon.svg" alt="<%= settings.name %>" width="40" height="40">
      </div>
      <div class="login-title">Welcome back</div>
      <div class="login-subtitle">Sign in to <%= settings.name %> dashboard</div>
    </div>

    <div class="glass-card">
      <a href="../auth" class="btn-login">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 127.14 96.36" fill="white"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
        Continue with Discord
      </a>

      <div class="divider">or</div>

      <a href="../panel" class="btn-panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/></svg>
        Open Pterodactyl Panel
      </a>

      <p class="terms">
        By signing in you agree to our
        <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
      </p>
    </div>
  </div>

  <div class="version-badge"><%= settings.name %> v<%= settings.version %></div>

  <script src="/assets/default/js/app.js"></script>
  <%- include('../Components/LoadingBar.ejs') %>
</body>
</html>