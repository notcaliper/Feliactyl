<!DOCTYPE html>
<html lang="en">
<%- include('../Components/Header.ejs') %>
<%- include('../Components/Styles.ejs') %>

<body>
  <div class="e404-wrap">

    <!-- ambient glow orbs -->
    <div class="e404-orb e404-orb1"></div>
    <div class="e404-orb e404-orb2"></div>

    <div class="e404-center">

      <!-- big 404 -->
      <div class="e404-num" aria-hidden="true">404</div>

      <!-- heading -->
      <h1 class="e404-title">Page Not Found</h1>
      <p class="e404-sub">The page you're looking for doesn't exist or has been moved.</p>

      <!-- card -->
      <div class="e404-card">
        <div class="e404-card-icon">
          <svg width="18" height="18" fill="none" stroke="#c4b5fd" stroke-width="2" viewBox="0 0 24 24">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <p class="e404-card-text">Lost? No worries — head back to the dashboard and pick up where you left off.</p>
        <div class="e404-card-actions">
          <a href="../dashboard" class="btn btn-primary e404-btn-home">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:-2px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Go to Dashboard
          </a>
          <a href="javascript:history.back()" class="btn btn-secondary e404-btn-back">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:-2px;"><polyline points="15 18 9 12 15 6"/></svg>
            Go Back
          </a>
        </div>
      </div>

    </div>
  </div>

  <%- include('../Components/LoadingBar.ejs') %>

  <style>
    html, body { height: 100%; margin: 0; }

    .e404-wrap {
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      font-family: 'Inter', 'DM Sans', sans-serif;
    }

    /* ambient orbs */
    .e404-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }
    .e404-orb1 {
      width: 420px; height: 420px;
      background: rgba(109,40,217,0.18);
      top: -80px; left: -100px;
      animation: orbFloat 8s ease-in-out infinite alternate;
    }
    .e404-orb2 {
      width: 320px; height: 320px;
      background: rgba(59,130,246,0.12);
      bottom: -60px; right: -80px;
      animation: orbFloat 10s ease-in-out infinite alternate-reverse;
    }
    @keyframes orbFloat {
      from { transform: translate(0, 0); }
      to   { transform: translate(30px, 20px); }
    }

    /* center container */
    .e404-center {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 32px 16px;
      max-width: 480px;
      width: 100%;
    }

    /* big number */
    .e404-num {
      font-size: clamp(96px, 20vw, 148px);
      font-weight: 900;
      letter-spacing: -8px;
      line-height: 1;
      background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 45%, #60a5fa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0.22;
      user-select: none;
      margin-bottom: 20px;
    }

    /* text */
    .e404-title {
      font-size: 28px !important;
      font-weight: 800 !important;
      color: #e2e8f0 !important;
      letter-spacing: -0.5px !important;
      margin: 0 0 10px !important;
      background: none !important;
      -webkit-text-fill-color: #e2e8f0 !important;
    }
    .e404-sub {
      font-size: 14px;
      color: #7c6faa;
      margin: 0 0 32px;
      line-height: 1.6;
    }

    /* card */
    .e404-card {
      width: 100%;
      background: var(--surface);
      border: 1px solid rgba(139,92,246,0.18);
      border-radius: 16px;
      padding: 28px 28px 24px;
      position: relative;
      overflow: hidden;
    }
    .e404-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      border-radius: 16px 16px 0 0;
      background: linear-gradient(90deg, #7c3aed, #a78bfa, #60a5fa);
    }

    .e404-card-icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: rgba(124,58,237,0.14);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 14px;
    }
    .e404-card-text {
      font-size: 13px;
      color: #7c6faa;
      line-height: 1.65;
      margin-bottom: 20px;
    }

    .e404-card-actions {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .e404-btn-home {
      font-size: 13px !important;
      padding: 9px 22px !important;
      display: inline-flex; align-items: center;
    }
    .e404-btn-back {
      font-size: 13px !important;
      padding: 9px 18px !important;
      display: inline-flex; align-items: center;
    }
  </style>

</body>
</html>