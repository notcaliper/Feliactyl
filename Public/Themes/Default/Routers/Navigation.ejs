<nav id="sidebar" class="sidebar js-sidebar">
  <div class="sidebar-content js-simplebar" style="display:flex;flex-direction:column;height:100%;">

    <!-- Brand -->
    <div class="sb-brand">
      <div class="sb-brand-icon">
        <img src="/assets/default/img/logo-icon.svg" alt="" style="width:20px;height:20px;">
      </div>
      <div>
        <span class="sb-brand-name"><%= settings.name %></span>
        <span class="sb-brand-tag">Dashboard</span>
      </div>
    </div>

    <!-- Nav -->
    <div class="sb-scroll">

      <div class="sb-group">
        <div class="sb-group-label">General</div>
        <a class="sb-link" href="/dashboard">
          <span class="sb-icon-wrap sb-icon-wrap--purple"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
          Dashboard
        </a>
        <a class="sb-link" href="/servers/new">
          <span class="sb-icon-wrap sb-icon-wrap--blue"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg></span>
          Create Server
        </a>
      </div>

      <div class="sb-group">
        <div class="sb-group-label">Earn &amp; Store</div>
        <% if (settings.api.arcio.enabled == true && settings.api.arcio['afk page'].enabled == true) { %>
        <a class="sb-link" href="/earn">
          <span class="sb-icon-wrap sb-icon-wrap--amber"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
          AFK Earn
        </a>
        <% } %>
        <% if (settings.linkvertise && settings.linkvertise.enabled == true) { %>
        <a class="sb-link" href="/linkvertise">
          <span class="sb-icon-wrap sb-icon-wrap--blue"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
          Linkvertise
        </a>
        <% } %>
        <a class="sb-link" href="/j4r">
          <span class="sb-icon-wrap sb-icon-wrap--green"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          Join for Rewards
        </a>
        <a class="sb-link" href="/gift">
          <span class="sb-icon-wrap sb-icon-wrap--pink"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
          Gift Coins
        </a>
        <a class="sb-link" href="/store">
          <span class="sb-icon-wrap sb-icon-wrap--purple"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
          Store
        </a>
        <a class="sb-link" href="/redeem">
          <span class="sb-icon-wrap sb-icon-wrap--green"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
          Redeem Coupon
        </a>
      </div>

      <% if (settings.stripe && settings.stripe.enabled == true) { %>
      <div class="sb-group">
        <div class="sb-group-label">Payments</div>
        <a class="sb-link" href="/buy">
          <span class="sb-icon-wrap sb-icon-wrap--amber"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></span>
          Buy Coins
        </a>
      </div>
      <% } %>

      <% if (pterodactyl.root_admin == true) { %>
      <div class="sb-group">
        <div class="sb-group-label">Admin</div>
        <a class="sb-link" href="/admin">
          <span class="sb-icon-wrap sb-icon-wrap--red"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
          Admin Panel
        </a>
        <a class="sb-link" href="/admin/users">
          <span class="sb-icon-wrap sb-icon-wrap--blue"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          Users
        </a>
        <a class="sb-link" href="/admin/settings">
          <span class="sb-icon-wrap sb-icon-wrap--purple"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
          Settings
        </a>
        <a class="sb-link" href="/admin/logs">
          <span class="sb-icon-wrap sb-icon-wrap--amber"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span>
          Logs
        </a>
      </div>
      <% } %>

    </div>

    <!-- User footer -->
    <div class="sb-user">
      <% const _sbInitial = (userinfo && userinfo.username) ? (userinfo.username.replace(/^[^a-zA-Z0-9]+/,'').charAt(0)||userinfo.username.charAt(0)).toUpperCase() : '?'; %>
      <% const _sbAvatar = (userinfo && userinfo.id && userinfo.avatar) ? 'https://cdn.discordapp.com/avatars/' + userinfo.id + '/' + userinfo.avatar + '.png?size=64' : null; %>
      <div class="sb-user-avatar" style="<%= _sbAvatar ? 'padding:0;overflow:hidden;' : '' %>">
        <% if (_sbAvatar) { %><img src="<%= _sbAvatar %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.style.display='none';this.parentNode.textContent='<%= _sbInitial %>';"><% } else { %><%= _sbInitial %><% } %>
      </div>
      <div class="sb-user-info">
        <div class="sb-user-name"><%= (userinfo && userinfo.username) ? userinfo.username : 'User' %></div>
        <% if (typeof packagename !== 'undefined') { %><div class="sb-user-plan"><%= packagename %></div><% } %>
      </div>
      <div class="sb-user-actions">
        <a href="/settings" class="sb-user-btn" title="Settings">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
        <a href="/logout" class="sb-user-btn sb-user-btn--logout" title="Sign out">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </div>

  </div>

  <script>
    (function() {
      const path = window.location.pathname;
      document.querySelectorAll('.sb-link').forEach(a => {
        const href = a.getAttribute('href');
        if (href === path || (href !== '/' && path.startsWith(href))) {
          a.classList.add('sb-link--active');
        }
      });
    })();
  </script>
</nav>